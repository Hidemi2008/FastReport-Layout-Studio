<TfrxReport Tag="1" Version="2021.3" DotMatrixReport="False" EngineOptions.MaxMemSize="1024" EngineOptions.TempDir="C:\Users\Micro\AppData\Local\Temp\GansoTemp\" EngineOptions.UseFileCache="True" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="1522" PreviewOptions.OutlineWidth="250" PreviewOptions.Zoom="1" PrintOptions.Printer="Padrão" PrintOptions.PrintOnSheet="0" ReportOptions.Author="Jeferson N" ReportOptions.CreateDate="44910,7453171412" ReportOptions.Description.Text="" ReportOptions.Name="Vendas Retaguarda - Modelo: PADRÃO      Última Alteração: 23/03/2026 08:48:15" ReportOptions.LastChange="46309,6943875694" ScriptLanguage="PascalScript" ScriptText.Text="{===================================================================================}&#13;&#10;{                     &#62; &#62; &#62; Impresso - Venda Retaguarda   &#60; &#60; &#60;                     }&#13;&#10;{-----------------------------------------------------------------------------------}&#13;&#10;{ &#62; Criado   em 15/01/2025 Jeferson N. -&#62; Implementação CD 5440                     }&#13;&#10;{ &#62; Alterado em 05/01/2026 Jeferson N. -&#62; Implementação CD ???? [REL-397]           }&#13;&#10;{===================================================================================}&#13;&#10;const&#13;&#10;  EmptyStr = '';&#13;&#10;  sLineBreak = #13#10;&#13;&#10;  TOrderTexto = 'Ordenação Prioritária: %s';&#13;&#10;  TChave = Format('[DAV_IMPLAN]:REL_%s_%s\%s', [VarToStr(&#60;Modelo_Relatorio&#62;),'%s','%s']);&#13;&#10;  TChaveCampo = Format('[DAV_IMPLAN]:REL_%s_%s_%s\%s', [VarToStr(&#60;Modelo_Relatorio&#62;),'%s','%s','%s']);&#13;&#10;&#13;&#10;  TPerfil = ['DAV-C','DAV-O','DAV-P'];&#13;&#10;  TDefaultPerfil = ['G','G','G'];&#13;&#10;&#13;&#10;  TConfig = ['DESC_ITEM','ACRE_ITEM','DESC_FECH','ACRE_FECH','FRETE',&#13;&#10;             'PRI_END_0','PRI_END_1','PRI_END_2','PRI_END_3','PRI_END_4','PRI_END_5',&#13;&#10;             'OCULTAR_CLI_CONV','DESTACAR_DESC_FECH','EXIBIR_ACRE_FECH','EXIBIR_FRETE','PREENCHER_OBS','ORDENAR_POR','EXIBIR','QTDE_VIAS_IMP',&#13;&#10;             'MEIA_PAGINA','AUTO_REDIM','NAO_REPETIR_TITULO','EXIBIR_NUM_DOC_FISCAL','MARCA_DAGUA_ORC','MODO_IMPRESSAO',&#13;&#10;             'TT_ITENS','TT_AGRUPAMENTO','ZEBRAR_ITENS','COMPLETAR_PAGINA','OCULTAR_REF','OCULTAR_MARCA',&#13;&#10;             'AGRUPAMENTO','AGRUPAR_PROD','AGRUPAR_KIT','OBSERVACAO','LISTA_CAMPOS'];&#13;&#10;&#13;&#10;  TNaoTermico = ['MEIA_PAGINA','AUTO_REDIM','NAO_REPETIR_TITULO','EXIBIR_NUM_DOC_FISCAL','MARCA_DAGUA_ORC','MODO_IMPRESSAO',&#13;&#10;                 'TT_ITENS','TT_AGRUPAMENTO','ZEBRAR_ITENS','COMPLETAR_PAGINA','OCULTAR_REF','OCULTAR_MARCA',&#13;&#10;                 'AGRUPAMENTO','LISTA_CAMPOS'];&#13;&#10;&#13;&#10;  TDefaultG = [1,1,2,2,2, 0,1,2,3,4,5, 'N','N','S','S','N',0,0,'1', 'S','N','S','N','N',0, 'S','N','N','N','N','N', 'N','N','N',EmptyStr,'18,02,06,22,14,00,04,21'];&#13;&#10;  TDefaultT = [1,1,2,2,2, 0,1,2,3,4,5, 'N','N','S','S','N',0,0,'1', 'N','N','N','N','N',0, 'N','N','N','N','N','N', 'N','N','N',EmptyStr,EmptyStr];&#13;&#10;&#13;&#10;  TCampos = ['Acréscimo','Ambiente','Código','Código de Barras','Desconto','Desconto Unitário','Descrição Produto','Embalagem',&#13;&#10;             'Espaço em Branco','Estoque','Imagem do Produto','Localização','Marca','NCM do Produto','Quantidade','Referência Auxiliar',&#13;&#10;             'Referência Fornecedor','Sequência (Linha)','Sequência (Produto)','Situação de Entrega','Unidade de Media (Sigla)',&#13;&#10;             'Valor Total','Valor Unitário','Valor Unitário Líquido'];&#13;&#10;&#13;&#10;  TCampoPropriedades = ['Codigo','Text','Width','Left','HAlign','FontSize','FontBold','Mask','Somar','ExibirCod','SomenteOrcamento','ExibirBorda'];&#13;&#10;&#13;&#10;  TDefaultText = ['Acréscimo','Ambiente','Produto','Código Barras','Desconto','Desc. Unit.','Descrição do Produto','Embalagem',' ','Estoque',&#13;&#10;                  'Imagem','Localização','Marca','NCM Produto','Quantidade','Ref. Auxiliar','Ref. Fornecedor','Seq','Seq','Sit. Entrega',&#13;&#10;                  'UN','Valor Total','Valor Unit.','Vlr. Unt. Liq.'];&#13;&#10;  TDefaultWidth = [60,75,47,80,60,60,364,75,60,75,1,75,75,75,65,75,75,25,25,75,25,75,60,75];&#13;&#10;  TDefaultHAlign = [1,0,2,2,1,1,0,2,0,0,2,0,0,2,1,0,0,2,2,0,2,1,1,1];&#13;&#10;  TDefaultMask = [',0.00','','000000','',',0.00',',0.00','',',0.000','','','','','','',',0.000','','','00','00','','',',0.00',',0.00',',0.00'];&#13;&#10;  TDefaultSomar = ['S','N','N','N','S','N','N','N','N','N','N','N','N','N','S','N','N','N','N','N','N','S','N','N'];&#13;&#10;&#13;&#10;  TPrioridadeEndereco = ['Entrega (Venda)','Entrega (Cad. Cliente)','Principal (Cad. Cliente)','Cobrança (Cad. Cliente)',&#13;&#10;                         'Propriedade (Cad. Cliente)','Cliente Convênio (Cad. Cliente)'];&#13;&#10;  TParametroPrioridadeEndereco = ['ENT_VEN','ENT_CAD','PRI_CAD','COB_CAD','PRO_CAD','CLI_CON'];&#13;&#10;  TTamanhoImg = [37,56,75];&#13;&#10;&#13;&#10;  TOrdenarBy = ['Sequência','Código do Produto','Descrição do Produto','Localização','Marca','Situação de Entrega','Estoque','Ambiente'];&#13;&#10;  TOrdenarPor = ['1','3','5','8','7','9','14','16'];&#13;&#10;&#13;&#10;  TConfigTermico = ['Marca','Localização','Sit. de Entrega','Quantidade','Valor Unitário','Desconto','Acréscimo',&#13;&#10;                    'Valor Unitário Líquido','Valor Total','Tipo Marca','Tipo Localização'];&#13;&#10;  TDefaulTermico = ['N','N','N','S','S','S','N','N','S',1,2];&#13;&#10;&#13;&#10;var&#13;&#10;  FIndexSelecionado, FSequencia: Integer = 0;&#13;&#10;  FPerfilConfig, FObservacao, FCampoSelecionado: String = EmptyStr;&#13;&#10;  FConfigGrafico, FGConfigGrafico, FListaProdutos: Array of TStringList;&#13;&#10;  FPerfil, FGPerfil, FConfig, FGConfig, FConfigTermico, FGConfigTermico: Array of Variant;&#13;&#10;&#13;&#10;procedure FrxRelatorioOnStartReport(Sender: TfrxComponent);&#13;&#10;var&#13;&#10;  lCountReg, lCountFin, lQtde: Integer = 0;&#13;&#10;  lSomenteORC: Boolean;&#13;&#10;begin&#13;&#10;  pgTermico.Visible := False;&#13;&#10;  pgGrafico.Visible := False;&#13;&#10;  pgGrafico.PaperHeight := 297;&#13;&#10;  TableObjectHeader.ColumnCount := 0;&#13;&#10;  TableObjectMasterData.ColumnCount := 0;&#13;&#10;  TableObjectFooter.ColumnCount := 0;&#13;&#10;  QryAddSQL(QryPrincipal, mmQryPrincipal.Text);&#13;&#10;&#13;&#10;  if frxGlobalVariables.Variables['Preview'] = 'S' then&#13;&#10;  begin&#13;&#10;    FPerfil := frxGlobalVariables.Variables['Perfil'];&#13;&#10;    FConfig := frxGlobalVariables.Variables['Config'];&#13;&#10;    FGPerfil := frxGlobalVariables.Variables['GPerfil'];&#13;&#10;    FGConfig := frxGlobalVariables.Variables['GConfig'];&#13;&#10;    FPerfilConfig := frxGlobalVariables.Variables['PerfilConfig'];&#13;&#10;    FConfigGrafico := frxGlobalVariables.Variables['ConfigGrafico'];&#13;&#10;    FConfigTermico := frxGlobalVariables.Variables['ConfigTermico'];&#13;&#10;    FGConfigGrafico := frxGlobalVariables.Variables['GConfigGrafico'];&#13;&#10;    FGConfigTermico := frxGlobalVariables.Variables['GConfigTermico'];&#13;&#10;    frxGlobalVariables.Variables['Preview'] := 'N';&#13;&#10;    TableObjectMasterData.Height := TableObjectHeader.Height;&#13;&#10;    CarregarConfiguracoesPreview;&#13;&#10;&#13;&#10;    SetPicture(imgConfig, True, imgPicture.Picture, 'imgConfiguradorOnPreviewClick', crHandPoint);&#13;&#10;    SetPicture(imgConfigurador, True, imgPicture.Picture, 'imgConfiguradorOnPreviewClick', crHandPoint);&#13;&#10;  end else&#13;&#10;  begin&#13;&#10;    LimparArray(FConfigGrafico);&#13;&#10;    LimparArray(FGConfigGrafico);&#13;&#10;    SetPicture(imgConfig, True, nil, EmptyStr, crDefault);&#13;&#10;    SetPicture(imgConfigurador, True, nil, EmptyStr, crDefault);&#13;&#10;    CarregarConfiguracoes;&#13;&#10;  end;&#13;&#10;&#13;&#10;  case FPerfilConfig of&#13;&#10;    'G': pgGrafico.Visible := True;&#13;&#10;    'T': pgTermico.Visible := True;&#13;&#10;  end;&#13;&#10;&#13;&#10;  IBXDatabase.Connected := False;&#13;&#10;  IBXDatabase.Connected := True;&#13;&#10;  FObservacao := GetObservacao;&#13;&#10;  MemoObservacao.Visible := not IsEmpty(FObservacao);&#13;&#10;  Report.PrintOptions.Copies := GetConfig('QTDE_VIAS_IMP');&#13;&#10;  Report.PrintOptions.PrintMode := GetConfig('MODO_IMPRESSAO');&#13;&#10;&#13;&#10;  if GetConfig('AGRUPAR_PROD') = 'S' then&#13;&#10;  begin&#13;&#10;    QryPrincipal.SQL.Text := StringReplace(QryPrincipal.SQL.Text,&#13;&#10;      'count(case when oi.kit_produto_mestre', 'count(distinct case when oi.kit_produto_mestre');&#13;&#10;  end;&#13;&#10;&#13;&#10;  if GetConfig('AGRUPAR_KIT') = 'S' then&#13;&#10;  begin&#13;&#10;    QryPrincipal.SQL.Text := StringReplace(QryPrincipal.SQL.Text,&#13;&#10;      'count(oi.kit_produto_mestre)', 'count(distinct oi.kit_produto_mestre)');&#13;&#10;  end;&#13;&#10;&#13;&#10;  AbrirQry(QryPrincipal);&#13;&#10;  AbrirQry(QryCliente);&#13;&#10;  AbrirQry(QryNegociacao);&#13;&#10;&#13;&#10;  if GetConfig('MEIA_PAGINA') = 'S' then&#13;&#10;  begin&#13;&#10;    lCountReg := &#60;QryPrincipal.&#34;QTD_PRODUTO&#34;&#62;;&#13;&#10;    lCountReg := lCountReg + &#60;QryPrincipal.&#34;QTD_PRODUTO_KIT&#34;&#62;;&#13;&#10;&#13;&#10;    if Pos(GetCampoID('Imagem do Produto'), GetConfig('LISTA_CAMPOS')) &#62; 0 then&#13;&#10;    begin&#13;&#10;      lSomenteORC := GetPropriedade('Imagem do Produto','SomenteOrcamento') = 'S';&#13;&#10;&#13;&#10;      if not lSomenteORC or (lSomenteORC and (&#60;frxDBDCadastral.&#34;TIPO_ORCAMENTO&#34;&#62; = 'O')) then&#13;&#10;      begin&#13;&#10;        case GetPropriedade('Imagem do Produto', 'Width') of&#13;&#10;          0: lCountReg := Int(lCountReg * 2.3) + IIF(Frac(lCountReg * 2.3) = 0, 0, 1);&#13;&#10;          1: lCountReg := Int(lCountReg * 3.2) + IIF(Frac(lCountReg * 3.2) = 0, 0, 1);&#13;&#10;          2: lCountReg := Int(lCountReg * 5.3) + IIF(Frac(lCountReg * 5.3) = 0, 0, 1);&#13;&#10;        end;&#13;&#10;      end;&#13;&#10;    end;&#13;&#10;&#13;&#10;    if &#60;QryPrincipal.&#34;QTD_FINALIZADOR&#34;&#62; &#62; 4 then&#13;&#10;      lCountReg := lCountReg + &#60;QryPrincipal.&#34;QTD_FINALIZADOR&#34;&#62; -4;&#13;&#10;&#13;&#10;    if GetConfig('PREENCHER_OBS') = 'S' then&#13;&#10;      lCountReg := lCountReg + &#60;QryPrincipal.&#34;QTD_OBSERVACAO&#34;&#62;;&#13;&#10;&#13;&#10;    case GetConfig('AGRUPAMENTO') of&#13;&#10;      'M': lCountReg := lCountReg + &#60;QryPrincipal.&#34;QTD_MARCA&#34;&#62;;&#13;&#10;      'A': lCountReg := lCountReg + &#60;QryPrincipal.&#34;QTD_AMBIENTE&#34;&#62;;&#13;&#10;      'S': lCountReg := lCountReg + &#60;QryPrincipal.&#34;QTD_SITUACAO_ENTREGA&#34;&#62;;&#13;&#10;    end;&#13;&#10;&#13;&#10;    if (GetConfig('AUTO_REDIM') = 'S') and (lCountReg &#60; 16) then&#13;&#10;      pgGrafico.PaperHeight := 148.5&#13;&#10;    else if not (GetConfig('AUTO_REDIM') = 'S') then&#13;&#10;      pgGrafico.PaperHeight := 148.5;&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure SetPicture(Picture: TfrxPictureView; pVisible: Boolean; pPicture: TPicture; pPreviewClick: String; pCursor: Integer);&#13;&#10;begin&#13;&#10;  Picture.Visible := pVisible;&#13;&#10;  Picture.Picture := pPicture;&#13;&#10;  Picture.OnPreviewClick := pPreviewClick;&#13;&#10;  Picture.Cursor := pCursor;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure pgGraficoOnBeforePrint(Sender: TfrxComponent);&#13;&#10;const&#13;&#10;  CGrupo = '[IIF(%s &#62; 0, FormatFloat(''000'', %s) + '' - '' + %s, ''&#60;DESCONHECIDO&#62;'')]';&#13;&#10;var&#13;&#10;  lOrderBy, lTTCampos: String = EmptyStr;&#13;&#10;begin&#13;&#10;  MemoTTGQtde.Visible  := False;&#13;&#10;  MemoTTGAcres.Visible := False;&#13;&#10;  MemoTTGDesc.Visible  := False;&#13;&#10;  MemoTTGTotal.Visible := False;&#13;&#10;  MemoGExibirT.Visible := True;&#13;&#10;  MemoGExibirV.Visible := True;&#13;&#10;  MemoGExibirV.HAlign := haLeft;&#13;&#10;  MemoGBrutoT.Width := 94.48818898;&#13;&#10;  MemoGDescT.Width := 56.69291339;&#13;&#10;  MemoGClienteT.Width := 253.22854661;&#13;&#10;  MemoGBrutoV.Width := MemoGBrutoT.Width;&#13;&#10;  MemoGDescV.Width := MemoGDescT.Width;&#13;&#10;  MemoGACrescT.Width := MemoGDescT.Width;&#13;&#10;  MemoGACrescV.Width := MemoGACrescT.Width;&#13;&#10;  MemoGFreteT.Width := MemoGACrescV.Width;&#13;&#10;  MemoGFreteV.Width := MemoGFreteT.Width;&#13;&#10;  MemoGDescT.Left := MemoGBrutoT.Left + MemoGBrutoT.Width;&#13;&#10;  MemoGACrescT.Left := MemoGDescT.Left + MemoGDescT.Width;&#13;&#10;  MemoGFreteT.Left := MemoGACrescT.Left + MemoGACrescT.Width;&#13;&#10;  MemoGACrescT.Visible := GetConfig('EXIBIR_ACRE_FECH') = 'S';&#13;&#10;  MemoGFreteT.Visible := GetConfig('EXIBIR_FRETE') = 'S';&#13;&#10;  MemoGACrescV.Visible := MemoGACrescT.Visible;&#13;&#10;  MemoGFreteV.Visible := MemoGFreteT.Visible;&#13;&#10;  MemoGDescV.Left := MemoGDescT.Left;&#13;&#10;  MemoGACrescV.Left := MemoGACrescT.Left;&#13;&#10;  MemoGFreteV.Left := MemoGFreteT.Left;&#13;&#10;  Memo59.Visible := not (&#60;QryPrincipal.&#34;OCULTAR_CLI_CONV&#34;&#62; = 'S');&#13;&#10;  MemoEditObsGrafico.Visible := GetConfig('PREENCHER_OBS') = 'S';&#13;&#10;  QryNegociacaoVALOR_TOTAL.Visible := not (&#60;QryPrincipal.&#34;OCULTAR_CLI_CONV&#34;&#62; = 'S');&#13;&#10;  MemoReimpressao.Visible := ((&#60;Controlar_ReImpressao_Dav&#62; = 'S') and (&#60;QryPrincipal.&#34;QTD_IMPRESSO&#34;&#62; &#62; 0) or&#13;&#10;                             ((&#60;frxDBDCadastral.&#34;TIPO_ORCAMENTO&#34;&#62; = 'O') and (GetConfig('MARCA_DAGUA_ORC') = 'S')));&#13;&#10;  Cabecalho.PrintOnFirstPage := not (GetConfig('NAO_REPETIR_TITULO') = 'S');&#13;&#10;  Cabecalho.Visible := not Cabecalho.PrintOnFirstPage;&#13;&#10;  MasterDataGraficoItem.Child := nil;&#13;&#10;  MasterDataGrafico.Child := nil;&#13;&#10;  Cabecalho.Child := nil;&#13;&#10;  Titulo.Child := nil;&#13;&#10;&#13;&#10;  if pgGrafico.PaperHeight = 148.5 then&#13;&#10;  begin&#13;&#10;    MarcaDagua.Height := 491.34;&#13;&#10;    MemoReimpressao.Font.Size := 48;&#13;&#10;  end else&#13;&#10;  begin&#13;&#10;    MarcaDagua.Height := 982.68;&#13;&#10;    MemoReimpressao.Font.Size := 65;&#13;&#10;  end;&#13;&#10;&#13;&#10;  if not MemoGACrescV.Visible then&#13;&#10;  begin&#13;&#10;    MemoGDescT.Width := 85.039370085;&#13;&#10;    MemoGDescV.Width := MemoGDescT.Width;&#13;&#10;    MemoGFreteT.Width :=  MemoGDescT.Width;&#13;&#10;    MemoGFreteV.Width := MemoGFreteT.Width;&#13;&#10;    MemoGFreteT.Left := MemoGDescT.Left + MemoGDescT.Width;&#13;&#10;    MemoGFreteV.Left := MemoGFreteT.Left;&#13;&#10;  end;&#13;&#10;&#13;&#10;  case GetConfig('NAO_REPETIR_TITULO') of&#13;&#10;    'S': Titulo.Child := ChildEmpresa;&#13;&#10;    else Cabecalho.Child := ChildEmpresa;&#13;&#10;  end;&#13;&#10;&#13;&#10;  if GetConfig('PREENCHER_OBS') = 'S' then&#13;&#10;    MasterDataGraficoItem.Child := ChildGraficoObs;&#13;&#10;&#13;&#10;  if GetConfig('COMPLETAR_PAGINA') = 'S' then&#13;&#10;    MasterDataGrafico.Child := ChildCompletarPagina;&#13;&#10;&#13;&#10;  case GetConfig('EXIBIR_NUM_DOC_FISCAL') of&#13;&#10;    'S': Memo7.Text := '[IIF(IsEmpty(&#60;QryPrincipal.&#34;DOC_FISCAL&#34;&#62;),&#60;frxDBDCadastral.&#34;CODIGO&#34;&#62;, ''&#60;b&#62;'' + IntToStr(&#60;frxDBDCadastral.&#34;CODIGO&#34;&#62;) + ''&#60;/b&#62; | '' + &#60;QryPrincipal.&#34;DOC_FISCAL&#34;&#62;)]';&#13;&#10;    else Memo7.Text := '[frxDBDCadastral.&#34;CODIGO&#34;]';&#13;&#10;  end;&#13;&#10;&#13;&#10;  Memo79.Text := Memo7.Text;&#13;&#10;&#13;&#10;  if not MemoGFreteT.Visible and not MemoGACrescV.Visible then&#13;&#10;  begin&#13;&#10;    MemoGBrutoT.Width := MemoGLiquidoT.Width;&#13;&#10;    MemoGBrutoV.Width := MemoGBrutoT.Width;&#13;&#10;    MemoGDescT.Width := MemoGLiquidoV.Width;&#13;&#10;    MemoGDescT.Left := MemoGLiquidoV.Left;&#13;&#10;    MemoGDescV.Width := MemoGDescT.Width;&#13;&#10;    MemoGDescV.Left := MemoGDescT.Left;&#13;&#10;  end else if not MemoGFreteT.Visible then&#13;&#10;  begin&#13;&#10;    MemoGDescT.Width := 85.039370085;&#13;&#10;    MemoGACrescT.Width := MemoGDescT.Width;&#13;&#10;    MemoGACrescV.Width := MemoGACrescT.Width;&#13;&#10;    MemoGDescV.Width := MemoGDescT.Width;&#13;&#10;    MemoGACrescT.Left := MemoGDescV.Left + MemoGDescV.Width;&#13;&#10;    MemoGACrescV.Left := MemoGACrescT.Left;&#13;&#10;  end;&#13;&#10;&#13;&#10;  case GetConfig('EXIBIR') of&#13;&#10;    1: begin&#13;&#10;      MemoGExibirT.Text := 'Cliente Convênio';&#13;&#10;      MemoGExibirV.Text := '[QryPrincipal.&#34;CODIGO_USUARIO_CONVENIO&#34;] - [QryPrincipal.&#34;CLIENTE_CONVENIO&#34;]';&#13;&#10;      MemoGExibirT.Visible := &#60;QryPrincipal.&#34;CODIGO_USUARIO_CONVENIO&#34;&#62; &#62; 0;&#13;&#10;    end;&#13;&#10;    2: begin&#13;&#10;      MemoGExibirT.Text := 'Cliente Parceiro';&#13;&#10;      MemoGExibirV.Text := '[QryPrincipal.&#34;CODIGO_CLIENTE_PARCEIRO&#34;] - [QryPrincipal.&#34;CLIENTE_PARCEIRO&#34;]';&#13;&#10;      MemoGExibirT.Visible := &#60;QryPrincipal.&#34;CODIGO_CLIENTE_PARCEIRO&#34;&#62; &#62; 0;&#13;&#10;    end;&#13;&#10;    3: begin&#13;&#10;      MemoGExibirV.HAlign := haCenter;&#13;&#10;      MemoGExibirT.Text := 'Identificação';&#13;&#10;      MemoGExibirV.Text := '[QryPrincipal.&#34;IDENTIFICACAO&#34;]';&#13;&#10;      MemoGExibirT.Visible := not IsEmpty(&#60;QryPrincipal.&#34;IDENTIFICACAO&#34;&#62;);&#13;&#10;    end;&#13;&#10;    4: begin&#13;&#10;      MemoGExibirT.Text := 'Propriedade';&#13;&#10;      MemoGExibirV.Text := '[QryPrincipal.&#34;CODIGO_PROPRIEDADE&#34;] - [QryPrincipal.&#34;CLIENTE_PROPRIEDADE&#34;]';&#13;&#10;      MemoGExibirT.Visible := &#60;QryPrincipal.&#34;CODIGO_PROPRIEDADE&#34;&#62; &#62; 0;&#13;&#10;    end;&#13;&#10;    else MemoGExibirT.Visible := False;&#13;&#10;  end;&#13;&#10;&#13;&#10;  if GetConfig('ZEBRAR_ITENS') = 'S' then&#13;&#10;  begin&#13;&#10;    MemoEstilo.Highlight.Color := $00E4E4E4;&#13;&#10;    MemoEstilo.Highlight.ApplyFont := False;&#13;&#10;    MemoEstilo.Highlight.ApplyFrame := False;&#13;&#10;    MemoEstilo.Highlight.Condition := '&#60;Line&#62; mod 2 = 0';&#13;&#10;&#13;&#10;    MemoCompletarPagina.Highlight.Color := $00E4E4E4;&#13;&#10;    MemoCompletarPagina.Highlight.ApplyFont := False;&#13;&#10;    MemoCompletarPagina.Highlight.ApplyFrame := False;&#13;&#10;    MemoCompletarPagina.Highlight.Condition := '&#60;Line&#62; mod 2 = 0';&#13;&#10;  end else&#13;&#10;  begin&#13;&#10;    MemoEstilo.Highlight.Condition := nil;&#13;&#10;    MemoCompletarPagina.Highlight.Condition := nil;&#13;&#10;  end;&#13;&#10;&#13;&#10;  if GetConfig('TT_AGRUPAMENTO') = 'S' then&#13;&#10;  begin&#13;&#10;    lTTCampos := GetConfig('LISTA_CAMPOS');&#13;&#10;    lTTCampos := Copy(lTTCampos, Pos(GetCampoID('Descrição Produto'), lTTCampos), Length(lTTCampos));&#13;&#10;    MemoTTGQtde.Visible  := Pos(GetCampoID('Quantidade') , lTTCampos) &#62; 0;&#13;&#10;    MemoTTGAcres.Visible := Pos(GetCampoID('Acréscimo')  , lTTCampos) &#62; 0;&#13;&#10;    MemoTTGDesc.Visible  := Pos(GetCampoID('Desconto')   , lTTCampos) &#62; 0;&#13;&#10;    MemoTTGTotal.Visible := Pos(GetCampoID('Valor Total'), lTTCampos) &#62; 0;&#13;&#10;&#13;&#10;    if MemoTTGQtde.Visible then&#13;&#10;    begin&#13;&#10;      MemoTTGQtde.Width := GetPropriedade('Quantidade', 'Width');&#13;&#10;      MemoTTGQtde.Left  := GetPropriedade('Quantidade', 'Left');&#13;&#10;    end;&#13;&#10;&#13;&#10;    if MemoTTGAcres.Visible then&#13;&#10;    begin&#13;&#10;      MemoTTGAcres.Width := GetPropriedade('Acréscimo', 'Width');&#13;&#10;      MemoTTGAcres.Left  := GetPropriedade('Acréscimo', 'Left');&#13;&#10;    end;&#13;&#10;&#13;&#10;    if MemoTTGDesc.Visible then&#13;&#10;    begin&#13;&#10;      MemoTTGDesc.Width := GetPropriedade('Desconto', 'Width');&#13;&#10;      MemoTTGDesc.Left  := GetPropriedade('Desconto', 'Left');&#13;&#10;    end;&#13;&#10;&#13;&#10;    if MemoTTGTotal.Visible then&#13;&#10;    begin&#13;&#10;      MemoTTGTotal.Width := GetPropriedade('Valor Total', 'Width');&#13;&#10;      MemoTTGTotal.Left  := GetPropriedade('Valor Total', 'Left');&#13;&#10;    end;&#13;&#10;  end;&#13;&#10;&#13;&#10;  if not MemoGExibirT.Visible then&#13;&#10;    MemoGClienteT.Width := MemoGClienteT.Width + MemoGExibirT.Width;&#13;&#10;&#13;&#10;  MemoGExibirV.Visible := MemoGExibirT.Visible;&#13;&#10;  MemoGClienteV.Width := MemoGClienteT.Width;&#13;&#10;&#13;&#10;  if (GetConfig('AGRUPAR_PROD') = 'S') and (GetConfig('AGRUPAR_KIT') = 'S') then&#13;&#10;    QryAddSQL(QryItens, mmQryItensProdutoKIT.Text)&#13;&#10;  else if GetConfig('AGRUPAR_PROD') = 'S' then&#13;&#10;    QryAddSQL(QryItens, mmQryItensProduto.Text)&#13;&#10;  else if GetConfig('AGRUPAR_KIT') = 'S' then&#13;&#10;    QryAddSQL(QryItens, mmQryItensKIT.Text)&#13;&#10;  else&#13;&#10;    QryAddSQL(QryItens, mmQryItens.Text);&#13;&#10;&#13;&#10;  case GetConfig('AGRUPAMENTO') of&#13;&#10;    'M': begin&#13;&#10;      lOrderBy := 'pm.descricao';&#13;&#10;      GroupHeader.Condition := 'QryItens.&#34;CODIGO_MARCA&#34;';&#13;&#10;      MemoGrupo.Text := Format(CGrupo, ['&#60;QryItens.&#34;CODIGO_MARCA&#34;&#62;', '&#60;QryItens.&#34;CODIGO_MARCA&#34;&#62;', '&#60;QryItens.&#34;DESCRICAO_MARCA&#34;&#62;']);&#13;&#10;    end;&#13;&#10;    'A': begin&#13;&#10;      lOrderBy := 'pa.descricao';&#13;&#10;      GroupHeader.Condition := 'QryItens.&#34;CODIGO_AMBIENTE&#34;';&#13;&#10;      MemoGrupo.Text := Format(CGrupo, ['&#60;QryItens.&#34;CODIGO_AMBIENTE&#34;&#62;', '&#60;QryItens.&#34;CODIGO_AMBIENTE&#34;&#62;', '&#60;QryItens.&#34;DESCRICAO_AMBIENTE&#34;&#62;']);&#13;&#10;      QryItens.SQL.Text := StringReplace(QryItens.SQL.Text, 'cast(null as type of column orcamento_item.codigo_ambiente)', 'oi.codigo_ambiente');&#13;&#10;      QryItens.SQL.Text := StringReplace(QryItens.SQL.Text, 'cast(null as type of column produto_ambiente.descricao)', 'pa.descricao');&#13;&#10;    end;&#13;&#10;    'S': begin&#13;&#10;      lOrderBy := 'oi.situacao_entrega';&#13;&#10;      GroupHeader.Condition := 'QryItens.&#34;SITUACAO_ENTREGA&#34;';&#13;&#10;      MemoGrupo.Text := '[GetSituacaoEntrega(&#60;QryItens.&#34;SITUACAO_ENTREGA&#34;&#62;)]';&#13;&#10;      QryItens.SQL.Text := StringReplace(QryItens.SQL.Text, 'cast(null as type of column orcamento_item.situacao_entrega)', 'oi.situacao_entrega');&#13;&#10;    end;&#13;&#10;    else GroupHeader.Condition := nil;&#13;&#10;  end;&#13;&#10;&#13;&#10;  if IsEmpty(lOrderBy) then&#13;&#10;    lOrderBy := TOrdenarPor[GetConfig('ORDENAR_POR')]&#13;&#10;  else&#13;&#10;    lOrderBy := lOrderBy + ',' + TOrdenarPor[GetConfig('ORDENAR_POR')];&#13;&#10;&#13;&#10;  GroupHeader.Visible := not (GetConfig('AGRUPAMENTO') in ['N','P']);&#13;&#10;//  GroupFooter.Visible := not (GetConfig('AGRUPAMENTO') in ['N','P']);&#13;&#10;&#13;&#10;  if not IsEmpty(lOrderBy) then&#13;&#10;    QryItens.SQL.Add(Format('order by %s', [lOrderBy]));&#13;&#10;&#13;&#10;  ReplaceGraficoAddFields(FConfigGrafico);&#13;&#10;  AbrirQry(QryItens);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure ReplaceGraficoAddFields(const pArray: Array of Variant);&#13;&#10;var&#13;&#10;  I: Integer = 0;&#13;&#10;begin&#13;&#10;  for I := 0 to Pred(pArray) do&#13;&#10;  begin&#13;&#10;    case GetPropriedadeIndex(I, 'Codigo') of&#13;&#10;      GetCampoID('Estoque'): begin&#13;&#10;        QryItens.SQL.Text := StringReplace(QryItens.SQL.Text, 'cast(null as type of column orcamento_item.codigo_estoque)', 'oi.codigo_estoque');&#13;&#10;        QryItens.SQL.Text := StringReplace(QryItens.SQL.Text, 'cast(null as type of column estoque.descricao)', 'e.descricao');&#13;&#10;      end;&#13;&#10;      GetCampoID('Localização'): begin&#13;&#10;        QryItens.SQL.Text := StringReplace(QryItens.SQL.Text, 'cast(null as type of column orcamento_item.codigo_estoque)', 'oi.codigo_estoque');&#13;&#10;        QryItens.SQL.Text := StringReplace(QryItens.SQL.Text, 'cast(null as type of column estoque_produto.localizacao)', 'ep.localizacao');&#13;&#10;      end;&#13;&#10;      GetCampoID('Ambiente'): begin&#13;&#10;        QryItens.SQL.Text := StringReplace(QryItens.SQL.Text, 'cast(null as type of column orcamento_item.codigo_ambiente)', 'oi.codigo_ambiente');&#13;&#10;        QryItens.SQL.Text := StringReplace(QryItens.SQL.Text, 'cast(null as type of column produto_ambiente.descricao)', 'pa.descricao');&#13;&#10;      end;&#13;&#10;      GetCampoID('Situação de Entrega'):&#13;&#10;        QryItens.SQL.Text := StringReplace(QryItens.SQL.Text, 'cast(null as type of column orcamento_item.situacao_entrega)', 'oi.situacao_entrega');&#13;&#10;    end;&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure QryAddSQL(pQuery: TfrxIBXQuery; pSQL: String);&#13;&#10;begin&#13;&#10;  pQuery.Close;&#13;&#10;  pQuery.SQL.Clear;&#13;&#10;  pQuery.SQL.Add(Trim(pSQL));&#13;&#10;end;&#13;&#10;&#13;&#10;procedure CarregarConfiguracoes;&#13;&#10;var&#13;&#10;  I: Integer = 0;&#13;&#10;  lLista: TStringList;&#13;&#10;  lDefault: Array of Variant;&#13;&#10;  lCodigo, lText, lWidth, lLeft, lHAlign, lFontSize, lFontBold, lMask, lSomar, lExibirCod, lSomenteORC, lExibirBorda: String = EmptyStr;&#13;&#10;begin&#13;&#10;  SetLength(FPerfil, Length(TPerfil));&#13;&#10;  SetLength(FConfig, Length(TConfig));&#13;&#10;  SetLength(FConfigTermico, Length(TConfigTermico));&#13;&#10;&#13;&#10;  for I := 0 to Pred(TPerfil) do&#13;&#10;    FPerfil[I] := fnGetCfg(1, Format(TChave, ['Impresso', TPerfil[I]]), TDefaultPerfil[I]);&#13;&#10;&#13;&#10;  FPerfilConfig := GetPerfil(&#60;frxDBDCadastral.&#34;TIPO_ORCAMENTO&#34;&#62;);&#13;&#10;&#13;&#10;  case FPerfilConfig of&#13;&#10;    'G': lDefault := TDefaultG;&#13;&#10;    'T': lDefault := TDefaultT;&#13;&#10;  end;&#13;&#10;&#13;&#10;  for I := 0 to Pred(TConfig) do&#13;&#10;    FConfig[I] := fnGetCfg(1, Format(TChave, [FPerfilConfig, TConfig[I]]), lDefault[I]);&#13;&#10;&#13;&#10;  for I := 0 to Pred(TConfigTermico) do&#13;&#10;    FConfigTermico[I] := fnGetCfg(1, Format(TChave, ['T', TConfigTermico[I]]), TDefaulTermico[I]);&#13;&#10;&#13;&#10;  lLista := TStringList.Create;&#13;&#10;  lLista.CommaText := fnGetCfg(1, Format(TChave, ['G', 'LISTA_CAMPOS']), TDefaultG[Pred(TConfig)]);&#13;&#10;&#13;&#10;  for I := 0 to lLista.Count -1 do&#13;&#10;  begin&#13;&#10;    lCodigo := lLista[I];&#13;&#10;    lText := fnGetCfg(1, Format(TChaveCampo, ['G', lCodigo, 'Text']), TDefaultText[StrToInt(lCodigo)]);&#13;&#10;    lWidth := fnGetCfg(1, Format(TChaveCampo, ['G', lCodigo, 'Width']), TDefaultWidth[StrToInt(lCodigo)]);&#13;&#10;    lLeft := fnGetCfg(1, Format(TChaveCampo, ['G', lCodigo, 'Left']), '0');&#13;&#10;    lHAlign := fnGetCfg(1, Format(TChaveCampo, ['G', lCodigo, 'HAlign']), TDefaultHAlign[StrToInt(lCodigo)]);&#13;&#10;    lFontSize := fnGetCfg(1, Format(TChaveCampo, ['G', lCodigo, 'FontSize']), '08');&#13;&#10;    lFontBold := fnGetCfg(1, Format(TChaveCampo, ['G', lCodigo, 'FontBold']), 'N');&#13;&#10;    lMask := fnGetCfg(1, Format(TChaveCampo, ['G', lCodigo, 'Mask']), TDefaultMask[StrToInt(lCodigo)]);&#13;&#10;    lSomar := fnGetCfg(1, Format(TChaveCampo, ['G', lCodigo, 'Somar']), TDefaultSomar[StrToInt(lCodigo)]);&#13;&#10;    lExibirCod := fnGetCfg(1, Format(TChaveCampo, ['G', lCodigo, 'ExibirCod']), 'N');&#13;&#10;    lSomenteORC := fnGetCfg(1, Format(TChaveCampo, ['G', lCodigo, 'SomenteOrcamento']), 'N');&#13;&#10;    lExibirBorda := fnGetCfg(1, Format(TChaveCampo, ['G', lCodigo, 'ExibirBorda']), 'N');&#13;&#10;&#13;&#10;    AdicionarCampo(FConfigGrafico, lCodigo, lText, lWidth, lLeft, lHAlign, lFontSize, lFontBold, lMask, lSomar, lExibirCod, lSomenteORC, lExibirBorda);&#13;&#10;    AdicionarField(I);&#13;&#10;  end;&#13;&#10;&#13;&#10;  CopyArrayStringList(FConfigGrafico, FGConfigGrafico);&#13;&#10;  CopyArray(FConfigTermico, FGConfigTermico);&#13;&#10;  CopyArray(FPerfil, FGPerfil);&#13;&#10;  CopyArray(FConfig, FGConfig);&#13;&#10;  lLista.Free;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure CarregarConfiguracoesPreview;&#13;&#10;var&#13;&#10;  I: Integer = 0;&#13;&#10;begin&#13;&#10;  for I := 0 to Pred(FConfigGrafico) do&#13;&#10;    AdicionarField(I);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure AdicionarField(pIndex: Integer);&#13;&#10;var&#13;&#10;  lExibirCampo: Boolean = False;&#13;&#10;begin&#13;&#10;  case GetPropriedadeIndex(pIndex, 'Codigo') of&#13;&#10;    GetCampoID('MARCA'): lExibirCampo := (&#60;frxDBDCadastral.&#34;TIPO_ORCAMENTO&#34;&#62; = 'O') and (GetConfig('OCULTAR_MARCA') = 'S');&#13;&#10;    GetCampoID('REFERÊNCIA FORNECEDOR'): lExibirCampo := (&#60;frxDBDCadastral.&#34;TIPO_ORCAMENTO&#34;&#62; = 'O') and (GetConfig('OCULTAR_REF') = 'S');&#13;&#10;    GetCampoID('REFERÊNCIA AUXILIAR'): lExibirCampo := (&#60;frxDBDCadastral.&#34;TIPO_ORCAMENTO&#34;&#62; = 'O') and (GetConfig('OCULTAR_REF') = 'S');&#13;&#10;    GetCampoID('IMAGEM DO PRODUTO'): lExibirCampo := not (&#60;frxDBDCadastral.&#34;TIPO_ORCAMENTO&#34;&#62; = 'O') and (GetPropriedade('Imagem do Produto', 'SomenteOrcamento') = 'S');&#13;&#10;    else lExibirCampo := False;&#13;&#10;  end;&#13;&#10;&#13;&#10;  if lExibirCampo then Exit;&#13;&#10;&#13;&#10;  CriarField('H', TableObjectHeader, pIndex);&#13;&#10;  CriarField('D', TableObjectMasterData, pIndex);&#13;&#10;  CriarField('F', TableObjectFooter, pIndex);&#13;&#10;end;&#13;&#10;&#13;&#10;function GetWidthOcultar(pLista: String): Integer;&#13;&#10;const&#13;&#10;  CFields = ['Marca','Referência Auxiliar','Referência Fornecedor','Imagem do Produto'];&#13;&#10;var&#13;&#10;  I: Integer = 0;&#13;&#10;  lOcultarRef, lOcultarMarca, lOrcamento, lSomenteORC: Boolean = False;&#13;&#10;  lCodigo, lWidth: String = EmptyStr;&#13;&#10;begin&#13;&#10;  Result := 0;&#13;&#10;  lOcultarRef := GetConfig('OCULTAR_REF') = 'S';&#13;&#10;  lOcultarMarca := GetConfig('OCULTAR_MARCA') = 'S';&#13;&#10;  lOrcamento := &#60;frxDBDCadastral.&#34;TIPO_ORCAMENTO&#34;&#62; = 'O';&#13;&#10;&#13;&#10;  for I := 0 to Pred(CFields) do&#13;&#10;  begin&#13;&#10;    lCodigo := GetCampoID(CFields[I]);&#13;&#10;&#13;&#10;    if Pos(lCodigo, pLista) = 0 then&#13;&#10;      Continue;&#13;&#10;&#13;&#10;    try&#13;&#10;      lWidth := GetPropriedade(CFields[I], 'Width');&#13;&#10;      lSomenteORC := GetPropriedade(CFields[I], 'SomenteOrcamento') = 'S';&#13;&#10;    except&#13;&#10;      lWidth := fnGetCfg(1, Format(TChaveCampo, [FPerfilConfig, lCodigo, 'Width']), TDefaultWidth[StrToInt(lCodigo)]);&#13;&#10;      lSomenteORC := fnGetCfg(1, Format(TChaveCampo, [FPerfilConfig, lCodigo, 'SomenteOrcamento']), 'N') = 'S';&#13;&#10;    end;&#13;&#10;&#13;&#10;    case CFields[I] of&#13;&#10;      'Marca': lWidth := IIF(lOrcamento and lOcultarMarca, lWidth, 0);&#13;&#10;      'Referência Auxiliar': lWidth := IIF(lOrcamento and lOcultarRef, lWidth, 0);&#13;&#10;      'Referência Fornecedor': lWidth := IIF(lOrcamento and lOcultarRef, lWidth, 0);&#13;&#10;      'Imagem do Produto': lWidth := IIF(not lOrcamento and lSomenteORC, TTamanhoImg[StrToInt(lWidth)], 0);&#13;&#10;    end;&#13;&#10;&#13;&#10;    Result := Result + StrToInt(lWidth);&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure CriarField(pTipo: Char; var pTabela: TfrxTableObject; pIndex: Integer);&#13;&#10;var&#13;&#10;  lIndex, lWidth: Integer = 0;&#13;&#10;  lCodigo, lText, lMask: String = EmptyStr;&#13;&#10;  lCellTabela: TfrxTableCell;&#13;&#10;  lImageProd: TfrxPictureView;&#13;&#10;begin&#13;&#10;  lMask := GetPropriedadeIndex(pIndex, 'Mask');&#13;&#10;  lCodigo := GetPropriedadeIndex(pIndex, 'Codigo');&#13;&#10;&#13;&#10;  case pTipo of&#13;&#10;    'H': lText := GetPropriedadeIndex(pIndex, 'Text');&#13;&#10;    'D': begin&#13;&#10;      if GetPropriedadeIndex(pIndex, 'ExibirCod') = 'S' then&#13;&#10;      begin&#13;&#10;        lText := GetField(lCodigo, lMask, 'S');&#13;&#10;        lText := StringReplace(lText, 'DESCRICAO', 'CODIGO');&#13;&#10;      end;&#13;&#10;&#13;&#10;      if (TCampos[StrToInt(lCodigo)] in ['Marca','Localização','Estoque','Ambiente']) then&#13;&#10;      begin&#13;&#10;        lMask := EmptyStr;&#13;&#10;&#13;&#10;        if GetPropriedadeIndex(pIndex, 'Somar') = 'S' then&#13;&#10;          lText := lText&#13;&#10;        else if GetPropriedadeIndex(pIndex, 'ExibirCod') = 'S' then&#13;&#10;          lText := lText + ' - ' + GetField(lCodigo, lMask)&#13;&#10;        else&#13;&#10;          lText := GetField(lCodigo, lMask);&#13;&#10;      end else&#13;&#10;        lText := GetField(lCodigo, lMask);&#13;&#10;&#13;&#10;      if (TCampos[StrToInt(lCodigo)] = 'Situação de Entrega') then&#13;&#10;      begin&#13;&#10;        lText := StringReplace(lText, '[', '[GetSituacaoEntrega(');&#13;&#10;        lText := StringReplace(lText, ']', ')]');&#13;&#10;      end;&#13;&#10;    end;&#13;&#10;    'F': lText := GetField(lCodigo);&#13;&#10;  end;&#13;&#10;&#13;&#10;  lWidth := StrToInt(GetPropriedadeIndex(pIndex, 'Width'));&#13;&#10;&#13;&#10;  if (TCampos[StrToInt(lCodigo)] = 'Imagem do Produto') then&#13;&#10;    lWidth := TTamanhoImg[lWidth];&#13;&#10;&#13;&#10;  if GetCampoID('Descrição Produto') = lCodigo then&#13;&#10;    lWidth := lWidth + GetWidthOcultar(GetConfig('LISTA_CAMPOS'));&#13;&#10;&#13;&#10;  lIndex := pTabela.ColumnCount + 1;&#13;&#10;  pTabela.ColumnCount := lIndex;&#13;&#10;  pTabela.Columns[lIndex -1].Width := lWidth;&#13;&#10;  lCellTabela := pTabela.Rows[0].Cells[lIndex -1];&#13;&#10;  lCellTabela.GapX := 3;&#13;&#10;  lCellTabela.Text := lText;&#13;&#10;  lCellTabela.Frame.Color := clGray;&#13;&#10;  lCellTabela.DisplayFormat.Kind := fkText;&#13;&#10;  lCellTabela.HAlign := StrToInt(GetPropriedadeIndex(pIndex, 'HAlign'));&#13;&#10;  lCellTabela.Font.Size := StrToInt(GetPropriedadeIndex(pIndex, 'FontSize'));&#13;&#10;  lCellTabela.WordWrap := False;&#13;&#10;&#13;&#10;  case pTipo of&#13;&#10;    'H': lCellTabela.Frame.Typ := ftBottom;&#13;&#10;    'F': lCellTabela.Frame.Typ := ftTop;&#13;&#10;    else lCellTabela.Frame.Typ := nil;&#13;&#10;  end;&#13;&#10;&#13;&#10;  if (GetCampoID('Espaço em Branco') = lCodigo) and (pTipo = 'D') then&#13;&#10;    lCellTabela.Frame.Typ := ftBottom;&#13;&#10;&#13;&#10;  if (pTipo in ['D','F']) then&#13;&#10;    lCellTabela.Font.Style := IIF(GetPropriedadeIndex(pIndex, 'FontBold') = 'S', fsBold, nil);&#13;&#10;&#13;&#10;  if (GetCampoID('Imagem do Produto') = lCodigo) and (pTipo = 'D') then&#13;&#10;  begin&#13;&#10;    lImageProd := TfrxPictureView.Create(lCellTabela);&#13;&#10;    lImageProd.Name := 'ImagemProduto';&#13;&#10;    lImageProd.HightQuality := True;&#13;&#10;    lImageProd.Height := lWidth;&#13;&#10;    lImageProd.Width := lWidth;&#13;&#10;    lImageProd.Center := True;&#13;&#10;    pTabela.Height := lWidth;&#13;&#10;&#13;&#10;    if GetPropriedadeIndex(pIndex, 'ExibirBorda') = 'S' then&#13;&#10;    begin&#13;&#10;      lImageProd.Frame.Typ := ftBottom + ftTop + ftLeft + ftRight;&#13;&#10;      lImageProd.Frame.Color := clGray;&#13;&#10;    end;&#13;&#10;  end;&#13;&#10;&#13;&#10;  if not (pTipo = 'F') then&#13;&#10;    Exit;&#13;&#10;&#13;&#10;  if (GetConfig('TT_ITENS') = 'S') and (GetPropriedadeIndex(pIndex, 'Somar') = 'S') then&#13;&#10;  begin&#13;&#10;    lCellTabela.Text := '[SUM(' + Copy(lText, 2, Length(lText) -2) + ',MasterDataGrafico)]';&#13;&#10;    lCellTabela.DisplayFormat.FormatStr := IIF(Pos(#35, lMask) = 0, #35, EmptyStr) + lMask;&#13;&#10;    lCellTabela.DisplayFormat.Kind := fkNumeric;&#13;&#10;  end else&#13;&#10;  begin&#13;&#10;    pTabela.Rows[0].Cells[lIndex -1].Text := EmptyStr;&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;function GetField(pCodigo: Char; pMask: String = ''; pValidar: Char = 'N'): String;&#13;&#10;var&#13;&#10;  lField, lCampo: String = EmptyStr;&#13;&#10;begin&#13;&#10;  Result := EmptyStr;&#13;&#10;  case pCodigo of&#13;&#10;    00: lField := 'ACRESCIMO_VALOR';&#13;&#10;    01: lField := 'DESCRICAO_AMBIENTE';&#13;&#10;    02: lField := 'CODIGO_PRODUTO';&#13;&#10;    03: lField := 'CODIGO_BARRA';&#13;&#10;    04: lField := 'DESCONTO_VALOR';&#13;&#10;    05: lCampo := Format('&#60;QryItens.&#34;%s&#34;&#62; / &#60;QryItens.&#34;%s&#34;&#62;', ['DESCONTO_VALOR', 'QUANTIDADE']);&#13;&#10;    06: lField := 'DESCRICAO_PRODUTO';&#13;&#10;    07: lField := 'EMBALAGEM';&#13;&#10;//    08: lField := EmptyStr; { Espaço em Branco }&#13;&#10;    09: lField := 'DESCRICAO_ESTOQUE';&#13;&#10;//    10: lField := EmptyStr; { Imagem do Produto }&#13;&#10;    11: lField := 'LOCALIZACAO';&#13;&#10;    12: lField := 'DESCRICAO_MARCA';&#13;&#10;    13: lField := 'NCM';&#13;&#10;    14: lField := 'QUANTIDADE';&#13;&#10;    15: lField := 'REF_PRODUTO_AUXILIAR';&#13;&#10;    16: lField := 'REF_PRODUTO_FORNEC';&#13;&#10;    17: lCampo := '&#60;FSequencia&#62;';&#13;&#10;    18: lField := 'SEQUENCIA';&#13;&#10;    19: lField := 'SITUACAO_ENTREGA';&#13;&#10;    20: lField := 'UNIDADE_MEDIDA';&#13;&#10;    21: lField := 'VALOR_TOTAL';&#13;&#10;    22: lField := 'PRECO_UNITARIO';&#13;&#10;    23: lCampo := Format('&#60;QryItens.&#34;%s&#34;&#62; / &#60;QryItens.&#34;%s&#34;&#62;', ['VALOR_TOTAL', 'QUANTIDADE']);&#13;&#10;    else Exit;&#13;&#10;  end;&#13;&#10;&#13;&#10;  if IsEmpty(lCampo) then&#13;&#10;    lCampo := Format('&#60;QryItens.&#34;%s&#34;&#62;', [lField]);&#13;&#10;&#13;&#10;  if not IsEmpty(pMask) then&#13;&#10;    lCampo := Format('FormatFloat(''%s'', %s)', [pMask, lCampo]);&#13;&#10;&#13;&#10;  if pValidar = 'S' then&#13;&#10;    lCampo := Format('IIF(&#60;QryItens.&#34;%s&#34;&#62; &#62; 0, %s, EmptyStr)', [lField, lCampo]);&#13;&#10;&#13;&#10;  Result := Format('[%s]', [lCampo]);&#13;&#10;end;&#13;&#10;&#13;&#10;function IsEmpty(s: String): Boolean;&#13;&#10;begin&#13;&#10;  Result := Trim(s) = EmptyStr;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure AbrirQry(var Query: TfrxIBXQuery; const pCodigoFilial: Integer = 0);&#13;&#10;var&#13;&#10;  I: Integer = 0;&#13;&#10;const&#13;&#10;  TMensage = 'Tentativa de executar ';&#13;&#10;begin&#13;&#10;  GeraMensagem(Format('%s%s, esta vazia!', [TMensage, Query.Name]), IsEmpty(Query.SQL.Text));&#13;&#10;&#13;&#10;  try&#13;&#10;    Query.Close;&#13;&#10;    for I := 0 to Query.Params.Count - 1 do&#13;&#10;    begin&#13;&#10;      Query.Params[I].Value := RetornarParametro(Query, Query.Params[I].Name, pCodigoFilial);&#13;&#10;    end;&#13;&#10;    Query.Open;&#13;&#10;  except&#13;&#10;    RaiseException(Format('%s%s%s%s', [TMensage, Query.Name, sLineBreak + sLineBreak, ExceptionMessage]));&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;function RetornarParametro(const Query: TfrxIBXQuery; const pParamByName: String; const pCodigoFilial: Integer): Variant;&#13;&#10;begin&#13;&#10;  case Uppercase(pParamByName) of&#13;&#10;    Uppercase('pDataInicial'):&#13;&#10;      Result := &#60;DataInicial&#62;;&#13;&#10;    Uppercase('pDataFinal'):&#13;&#10;      Result := &#60;DataFinal&#62;;&#13;&#10;    Uppercase('pCodigoFilial'):&#13;&#10;      Result := pCodigoFilial;&#13;&#10;    Uppercase('pCodOrcamento'):&#13;&#10;      Result := &#60;Cod_Orcamento&#62;;&#13;&#10;&#13;&#10;    Uppercase('pItemAcre'):&#13;&#10;      Result := GetTipoRateio(GetConfig('ACRE_ITEM'));&#13;&#10;    Uppercase('pItemDesc'):&#13;&#10;      Result := GetTipoRateio(GetConfig('DESC_ITEM'));&#13;&#10;    Uppercase('pFechAcre'):&#13;&#10;      Result := GetTipoRateio(GetConfig('ACRE_FECH'));&#13;&#10;    Uppercase('pFechDesc'):&#13;&#10;      Result := GetTipoRateio(GetConfig('DESC_FECH'));&#13;&#10;    Uppercase('pFrete'):&#13;&#10;      Result := GetTipoRateio(GetConfig('FRETE'));&#13;&#10;    Uppercase('pDestacarDesc'):&#13;&#10;      Result := GetConfig('DESTACAR_DESC_FECH');&#13;&#10;    Uppercase('pDescConv'):&#13;&#10;      Result := GetConfig('OCULTAR_CLI_CONV');&#13;&#10;&#13;&#10;    Uppercase('pCodigo_Cliente'):&#13;&#10;      Result := &#60;frxDBDCadastral.&#34;CODIGO_CLIENTE&#34;&#62;;&#13;&#10;    Uppercase('pCliente_Comvenio'):&#13;&#10;      Result := &#60;QryPrincipal.&#34;CODIGO_USUARIO_CONVENIO&#34;&#62;;&#13;&#10;    Uppercase('pEndereco_01'):&#13;&#10;      Result := TParametroPrioridadeEndereco[GetConfig('PRI_END_0')];&#13;&#10;    Uppercase('pEndereco_02'):&#13;&#10;      Result := TParametroPrioridadeEndereco[GetConfig('PRI_END_1')];&#13;&#10;    Uppercase('pEndereco_03'):&#13;&#10;      Result := TParametroPrioridadeEndereco[GetConfig('PRI_END_2')];&#13;&#10;    Uppercase('pEndereco_04'):&#13;&#10;      Result := TParametroPrioridadeEndereco[GetConfig('PRI_END_3')];&#13;&#10;    Uppercase('pEndereco_05'):&#13;&#10;      Result := TParametroPrioridadeEndereco[GetConfig('PRI_END_4')];&#13;&#10;    Uppercase('pEndereco_06'):&#13;&#10;      Result := TParametroPrioridadeEndereco[GetConfig('PRI_END_5')];&#13;&#10;  else&#13;&#10;    RaiseException(Format('Parametro &#34;%s&#34; não foi encontrado!', [pParamByName]));&#13;&#10;  end&#13;&#10;end;&#13;&#10;&#13;&#10;function GetTipoRateio(pCodigo: Integer): Char;&#13;&#10;begin&#13;&#10;  case pCodigo of&#13;&#10;    0: Result := 'U';&#13;&#10;    1: Result := 'I';&#13;&#10;    2: Result := 'F';&#13;&#10;    else Result := EmptyStr;&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure imgConfiguradorOnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  imgConfigurador.Visible := False;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure imgConfiguradorOnPreviewClick(Sender: TfrxView; Button: TMouseButton; Shift: Integer; var Modified: Boolean);&#13;&#10;begin&#13;&#10;  DlgConfig.ShowModal;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure imgConfiguradorOnPreviewDblClick(Sender: TfrxView; Button: TMouseButton; Shift: Integer; var Modified: Boolean);&#13;&#10;begin&#13;&#10;  if (Shift = 4) then&#13;&#10;  begin&#13;&#10;    TfrxPictureView(Sender).OnPreviewClick := 'imgConfiguradorOnPreviewClick';&#13;&#10;    TfrxPictureView(Sender).Picture := imgPicture.Picture;&#13;&#10;    TfrxPictureView(Sender).Cursor := crHandPoint;&#13;&#10;    Modified := True;&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure DlgConfigOnShow(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  ComboBoxTipo.ItemIndex := GetTipoPerfil;&#13;&#10;  ComboBoxTipoOnChange(Self);&#13;&#10;  PageControl.ActivePageIndex := 0;&#13;&#10;  ComboBoxTipo.SetFocus;&#13;&#10;  DlgConfig.Caption := Format('%s - Configurador DAV-Pedido', [VarToStr(&#60;Modelo_Relatorio&#62;)]);&#13;&#10;  AtualizarDialogo([GroupBox2,GroupBox3,GroupBox4,GroupBox5,tsGraficoPagina,tsGraficoItens,GroupBox7]);&#13;&#10;  AtualizarDialogoTermico([GroupBox9]);&#13;&#10;  MemoObsFixaOnKeyUp(Self,0,0);&#13;&#10;  DlgConfigOnResize(Self);&#13;&#10;  AtualizarCamposGrafico;&#13;&#10;  AtualizarImpresso;&#13;&#10;  ValidarAlteracaoConfig;&#13;&#10;  edtMasck.Hint :=&#13;&#10;    'Exemplo de Mascaras.' + sLineBreak + sLineBreak +&#13;&#10;    'Mascaras       Resultado' + sLineBreak +&#13;&#10;    '0.#                  1234,5' + sLineBreak +&#13;&#10;    '0.00                1234,50' + sLineBreak +&#13;&#10;    '0.000              1234,500' + sLineBreak +&#13;&#10;    ',0.00               1.234,50' + sLineBreak +&#13;&#10;    ',0.000             1.234,500' + sLineBreak +&#13;&#10;    'R$ #,0.00        R$ 1.234,50' + sLineBreak +&#13;&#10;    'R$ #,0.000      R$ 1.234,500' + sLineBreak +&#13;&#10;    '000000            012345';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure DlgConfigOnResize(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  DlgConfig.ClientHeight := GetDlgHeight;&#13;&#10;  DlgConfig.ClientWidth  := GetDlgWidtht;&#13;&#10;  BitBtnPreview.Visible := not (PageControl.TabIndex = 3);&#13;&#10;end;&#13;&#10;&#13;&#10;function GetDlgHeight: Extended;&#13;&#10;begin&#13;&#10;  case PageControl.TabIndex of&#13;&#10;    001: begin Result := 353; PageControl.Height := 295; end;&#13;&#10;    002: begin Result := 332; PageControl.Height := 274; end;&#13;&#10;    003: begin Result := 187; PageControl.Height := 129; end;&#13;&#10;    else begin Result := 672; PageControl.Height := 614; end;&#13;&#10;  end;&#13;&#10;&#13;&#10;  PanelBtn0.Top := PageControl.Height + PageControl.Top + 10;&#13;&#10;  PanelBtn1.Top := PageControl.Height + PageControl.Top + 10;&#13;&#10;end;&#13;&#10;&#13;&#10;function GetDlgWidtht: Extended;&#13;&#10;begin&#13;&#10;  case PageControl.TabIndex of&#13;&#10;    001: begin Result := 834; PageControl.Width := 820; end;&#13;&#10;    else begin Result := 518; PageControl.Width := 504; end;&#13;&#10;  end;&#13;&#10;&#13;&#10;  PanelBtn1.Left := PageControl.Left + PageControl.Width - PanelBtn1.Width;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure ComboBoxTipoOnChange(Sender: TfrxComponent);&#13;&#10;var&#13;&#10;  I: Integer = 0;&#13;&#10;  lDefault: Array of Variant;&#13;&#10;begin&#13;&#10;  if GetTipoPerfil = ComboBoxTipo.ItemIndex then&#13;&#10;    Exit;&#13;&#10;&#13;&#10;  if ValidarAlteracaoConfig then&#13;&#10;  begin&#13;&#10;    if GeraPergunta('Existe alterações não gravadas, deseja descartá-las?') = 7 then&#13;&#10;    begin&#13;&#10;      ComboBoxTipo.ItemIndex := GetTipoPerfil;&#13;&#10;      Exit;&#13;&#10;    end;&#13;&#10;  end;&#13;&#10;&#13;&#10;  case ComboBoxTipo.ItemIndex of&#13;&#10;    0: begin FPerfilConfig := 'G'; lDefault := TDefaultG; end;&#13;&#10;    1: begin FPerfilConfig := 'T'; lDefault := TDefaultT; end;&#13;&#10;  end;&#13;&#10;&#13;&#10;  for I := 0 to Pred(TConfig) do&#13;&#10;    FConfig[I] := fnGetCfg(1, Format(TChave, [FPerfilConfig, TConfig[I]]), lDefault[I]);&#13;&#10;&#13;&#10;  CopyArray(FConfig, FGConfig);&#13;&#10;  AtualizarDialogo([GroupBox2,GroupBox3,GroupBox4,GroupBox5,tsGraficoPagina,tsGraficoItens,GroupBox7]);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure AtualizarImpresso;&#13;&#10;begin&#13;&#10;  rbDAV_CG.Checked := GetPerfil('C') = 'G';&#13;&#10;  rbDAV_OG.Checked := GetPerfil('O') = 'G';&#13;&#10;  rbDAV_PG.Checked := GetPerfil('P') = 'G';&#13;&#10;  rbDAV_CT.Checked := GetPerfil('C') = 'T';&#13;&#10;  rbDAV_OT.Checked := GetPerfil('O') = 'T';&#13;&#10;  rbDAV_PT.Checked := GetPerfil('P') = 'T';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure AtualizarDialogo(pComponent: Array of TfrxGroupBoxControl);&#13;&#10;var&#13;&#10;  I,J: Integer = 0;&#13;&#10;  lComponente: TList;&#13;&#10;  lEnabled: Boolean = False;&#13;&#10;  lDescription: String = EmptyStr;&#13;&#10;begin&#13;&#10;  case GetConfig('AGRUPAMENTO') of&#13;&#10;    'M': begin rbAgrupamentoM.Checked := True; LabelOrdernacaoP.Caption := Format(TOrderTexto, ['Marca']); end;&#13;&#10;    'A': begin rbAgrupamentoA.Checked := True; LabelOrdernacaoP.Caption := Format(TOrderTexto, ['Ambiente']); end;&#13;&#10;    'S': begin rbAgrupamentoS.Checked := True; LabelOrdernacaoP.Caption := Format(TOrderTexto, ['Sit. Entrega']); end;&#13;&#10;    else begin rbAgrupamentoN.Checked := True; LabelOrdernacaoP.Caption := Format(TOrderTexto, ['Nenhum']); end;&#13;&#10;  end;&#13;&#10;&#13;&#10;  AtualizarPrioridadeEndereco;&#13;&#10;  cbOrderBy.Items.Clear;&#13;&#10;&#13;&#10;  for I := 0 to Pred(TOrdenarBy) do&#13;&#10;  begin&#13;&#10;    if (FPerfilConfig = 'T') and (I &#62; Pred(TOrdenarBy) -2) then&#13;&#10;      Continue;&#13;&#10;&#13;&#10;    cbOrderBy.Items.Add(TOrdenarBy[I]);&#13;&#10;  end;&#13;&#10;&#13;&#10;  for I := 0 to Pred(pComponent) do&#13;&#10;  begin&#13;&#10;    lComponente := pComponent[I].Objects;&#13;&#10;&#13;&#10;    for J := 0 to (lComponente.Count - 1) do&#13;&#10;    begin&#13;&#10;      lEnabled := True;&#13;&#10;      lDescription := TfrxDialogComponent(lComponente.Items[J]).Description;&#13;&#10;&#13;&#10;      if IsEmpty(lDescription) then&#13;&#10;        Continue;&#13;&#10;&#13;&#10;      case lComponente.Items[J].ClassName of&#13;&#10;        'TfrxComboBoxControl': TfrxComboBoxControl(lComponente.Items[J]).ItemIndex := GetConfig(lDescription);&#13;&#10;        'TfrxCheckBoxControl': TfrxCheckBoxControl(lComponente.Items[J]).Checked := GetConfig(lDescription) = 'S';&#13;&#10;        'TfrxEditControl': TfrxEditControl(lComponente.Items[J]).Text := GetConfig(lDescription);&#13;&#10;      end;&#13;&#10;&#13;&#10;      if (FPerfilConfig = 'T') and (lDescription in TNaoTermico) then&#13;&#10;      begin&#13;&#10;        lEnabled := False;&#13;&#10;        LabelOrdernacaoP.Caption := Format(TOrderTexto, ['Nenhum']);&#13;&#10;      end;&#13;&#10;&#13;&#10;      case lComponente.Items[J].ClassName of&#13;&#10;        'TfrxEditControl': TfrxEditControl(lComponente.Items[J]).Enabled := lEnabled;&#13;&#10;        'TfrxComboBoxControl': TfrxComboBoxControl(lComponente.Items[J]).Enabled := lEnabled;&#13;&#10;        'TfrxCheckBoxControl': TfrxCheckBoxControl(lComponente.Items[J]).Enabled := lEnabled;&#13;&#10;        'TfrxRadioButtonControl': TfrxRadioButtonControl(lComponente.Items[J]).Enabled := lEnabled;&#13;&#10;      end;&#13;&#10;    end;&#13;&#10;  end;&#13;&#10;&#13;&#10;  CheckBox29.Enabled := 1 in [GetConfig('DESC_ITEM'), GetConfig('DESC_FECH')];&#13;&#10;  MemoObsFixa.Lines.CommaText := GetConfig(MemoObsFixa.Description);&#13;&#10;  CheckBox15.Enabled := GetConfig('AGRUPAMENTO') &#60;&#62; 'N';&#13;&#10;&#13;&#10;  if ListBoxEndereco.ItemIndex &#60; 0 then&#13;&#10;    ListBoxEndereco.ItemIndex := 0;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure AtualizarPrioridadeEndereco;&#13;&#10;var&#13;&#10;  I: Integer = 0;&#13;&#10;begin&#13;&#10;  ListBoxEndereco.Items.Clear;&#13;&#10;&#13;&#10;  for I := 0 to Pred(TParametroPrioridadeEndereco) do&#13;&#10;    ListBoxEndereco.Items.Add(TPrioridadeEndereco[GetConfig(Format('PRI_END_%d', [I]))]);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure sbtnInsertOnClick(Sender: TfrxComponent);&#13;&#10;var&#13;&#10;  I: Integer = 0;&#13;&#10;  lCodigo: Char = EmptyStr;&#13;&#10;  lHasInsert: Boolean = False;&#13;&#10;begin&#13;&#10;  for I := 0 to clbGraficoDisponivel.Items.Count -1 do&#13;&#10;  begin&#13;&#10;    if clbGraficoDisponivel.Checked[I] then&#13;&#10;    begin&#13;&#10;      lHasInsert := True;&#13;&#10;      lCodigo := GetCampoID(clbGraficoDisponivel.Items[I]);&#13;&#10;&#13;&#10;      AdicionarCampo(FConfigGrafico, lCodigo,&#13;&#10;        TDefaultText[StrToInt(lCodigo)],&#13;&#10;        TDefaultWidth[StrToInt(lCodigo)],&#13;&#10;        '0',&#13;&#10;        TDefaultHAlign[StrToInt(lCodigo)],&#13;&#10;        '08','N',&#13;&#10;        TDefaultMask[StrToInt(lCodigo)],&#13;&#10;        TDefaultSomar[StrToInt(lCodigo)],&#13;&#10;        'N','N','N'&#13;&#10;      );&#13;&#10;    end;&#13;&#10;  end;&#13;&#10;&#13;&#10;  if lHasInsert then&#13;&#10;    AtualizarCamposGrafico;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure sbtnDeleteOnClick(Sender: TfrxComponent);&#13;&#10;var&#13;&#10;  I, J, K, M, vAux: Integer = 0;&#13;&#10;  lCodigo: Char = EmptyStr;&#13;&#10;  lValidacao, lHasDelete: Boolean = False;&#13;&#10;  oldTexto ,newTexto: String = EmptyStr;&#13;&#10;begin&#13;&#10;  for I := 0 to clbGraficoExibir.Items.Count -1 do&#13;&#10;  begin&#13;&#10;    if clbGraficoExibir.Checked[I] then&#13;&#10;    begin&#13;&#10;      Inc(vAux);&#13;&#10;      lCodigo := GetCampoID(clbGraficoExibir.Items[I]);&#13;&#10;&#13;&#10;      if (clbGraficoExibir.Items[I] = 'Descrição Produto') then&#13;&#10;      begin&#13;&#10;        lValidacao := True;&#13;&#10;        Dec(vAux);&#13;&#10;        Continue;&#13;&#10;      end;&#13;&#10;&#13;&#10;      for J := 0 to Pred(FConfigGrafico) do&#13;&#10;      begin&#13;&#10;        if GetPropriedadeIndex(J, 'Codigo') = lCodigo then&#13;&#10;        begin&#13;&#10;          for K := J to Pred(FConfigGrafico, 2) do&#13;&#10;          begin&#13;&#10;            oldTexto := FConfigGrafico[K].CommaText;&#13;&#10;            newTexto := FConfigGrafico[K+1].CommaText;&#13;&#10;            FConfigGrafico[K].CommaText := newTexto;&#13;&#10;            FConfigGrafico[K+1].CommaText := oldTexto;&#13;&#10;          end;&#13;&#10;        end;&#13;&#10;      end;&#13;&#10;    end&#13;&#10;  end;&#13;&#10;&#13;&#10;  for I := Pred(FConfigGrafico) downto (Length(FConfigGrafico) - vAux) do&#13;&#10;  begin&#13;&#10;    lHasDelete := True;&#13;&#10;    lCodigo := GetPropriedadeIndex(I, 'Codigo');&#13;&#10;    FConfigGrafico[I].Free;&#13;&#10;    SetLength(FConfigGrafico , I);&#13;&#10;    TfrxMemoControl(Report.FindObject(Format('PreviwMT_%d', [StrToInt(lCodigo)]))).Free;&#13;&#10;  end;&#13;&#10;&#13;&#10;  if lHasDelete then&#13;&#10;  begin&#13;&#10;    AtualizarCamposGrafico;&#13;&#10;    clbGraficoExibirOnClick(Self);&#13;&#10;  end;&#13;&#10;&#13;&#10;  GeraMensagem('Descrição do Produto não pode ser removido!', lValidacao, False);&#13;&#10;end;&#13;&#10;&#13;&#10;function GetTipoPerfil: Integer;&#13;&#10;begin&#13;&#10;  case FPerfilConfig of&#13;&#10;    'G': Result := 0;&#13;&#10;    'T': Result := 1;&#13;&#10;    else RaiseException('Perfil não encontrado!')&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;function GetPerfil(pTipo: String): Char;&#13;&#10;var&#13;&#10;  I: Integer = 0;&#13;&#10;begin&#13;&#10;  for I := 0 to Pred(TPerfil) do&#13;&#10;  begin&#13;&#10;    if Format('DAV-%s', [pTipo]) = TPerfil[I] then&#13;&#10;      Result := FPerfil[I];&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;function GetConfigID(pNome: String): Integer;&#13;&#10;begin&#13;&#10;  Result := GetID(TConfig, pNome, 'Configuração');&#13;&#10;end;&#13;&#10;&#13;&#10;function GetCampoID(pNome: String): Char;&#13;&#10;begin&#13;&#10;  Result := FormatFloat('00', GetID(TCampos, pNome, 'Campo'));&#13;&#10;end;&#13;&#10;&#13;&#10;function GetPropriedadeID(pNome: String): Integer;&#13;&#10;begin&#13;&#10;  Result := GetID(TCampoPropriedades, pNome, 'Campo_Propriedade');&#13;&#10;end;&#13;&#10;&#13;&#10;function GetEnderecoID(pNome: String): Integer;&#13;&#10;begin&#13;&#10;  Result := GetID(TPrioridadeEndereco, pNome, 'Prioridade_Endereco');&#13;&#10;end;&#13;&#10;&#13;&#10;function GetTermicoID(pNome: String): Integer;&#13;&#10;begin&#13;&#10;  Result := GetID(TConfigTermico, pNome, 'Térmico');&#13;&#10;end;&#13;&#10;&#13;&#10;function GetID(pLista: Array of variant; pNome, pNomeLista: String): Integer;&#13;&#10;var&#13;&#10;  I: Integer = 0;&#13;&#10;  HasData: Boolean = False;&#13;&#10;begin&#13;&#10;  HasData := False;&#13;&#10;&#13;&#10;  for I := 0 to Pred(pLista) do&#13;&#10;  begin&#13;&#10;    if Lowercase(pLista[I]) = Lowercase(pNome) then&#13;&#10;    begin&#13;&#10;      HasData := True;&#13;&#10;      Result := I;&#13;&#10;      Break;&#13;&#10;    end;&#13;&#10;  end;&#13;&#10;&#13;&#10;  if not HasData then&#13;&#10;    RaiseException(Format('Não localizado ID para o campo: %s na lista: %s.', [pNome, pNomeLista]));&#13;&#10;end;&#13;&#10;&#13;&#10;function GetConfig(pCampo: String): Variant;&#13;&#10;var&#13;&#10;  I: Integer = 0;&#13;&#10;begin&#13;&#10;  Result := EmptyStr;&#13;&#10;&#13;&#10;  for I := 0 to Pred(TConfig) do&#13;&#10;  begin&#13;&#10;    if Lowercase(TConfig[I]) = Lowercase(pCampo) then&#13;&#10;    begin&#13;&#10;      Result := FConfig[I];&#13;&#10;      Break;&#13;&#10;    end;&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;function GetCampo(pNome: String): TStringList;&#13;&#10;var&#13;&#10;  I: Integer = 0;&#13;&#10;  HasData: Boolean = False;&#13;&#10;begin&#13;&#10;  Result := nil;&#13;&#10;&#13;&#10;  for I := 0 to Pred(FConfigGrafico) do&#13;&#10;  begin&#13;&#10;    if GetPropriedadeIndex(I, 'Codigo') = GetCampoID(pNome) then&#13;&#10;    begin&#13;&#10;      Result := FConfigGrafico[I];&#13;&#10;      HasData := True;&#13;&#10;      Break;&#13;&#10;    end;&#13;&#10;  end;&#13;&#10;&#13;&#10;  if not HasData then&#13;&#10;    RaiseException(Format('Não localizado o campo: &#34;%s&#34;.', [pNome]));&#13;&#10;end;&#13;&#10;&#13;&#10;function GetPropriedade(pCampo, pPropriedade: String; pNewValue: String = 'ADD_VALUE'): Variant;&#13;&#10;var&#13;&#10;  I: Integer = 0;&#13;&#10;  HasData: Boolean = False;&#13;&#10;begin&#13;&#10;  Result := nil;&#13;&#10;&#13;&#10;  for I := 0 to Pred(TCampoPropriedades) do&#13;&#10;  begin&#13;&#10;    if Lowercase(TCampoPropriedades[I]) = Lowercase(pPropriedade) then&#13;&#10;    begin&#13;&#10;      if not (pNewValue = 'ADD_VALUE') and (I &#62; 0) then&#13;&#10;      begin&#13;&#10;        GetCampo(pCampo)[I] := pNewValue;&#13;&#10;        ValidarAlteracaoGrafico;&#13;&#10;      end;&#13;&#10;&#13;&#10;      Result := GetCampo(pCampo)[I];&#13;&#10;      HasData := True;&#13;&#10;      Break;&#13;&#10;    end;&#13;&#10;  end;&#13;&#10;&#13;&#10;  if not HasData then&#13;&#10;    RaiseException(Format('Não localizado a Propriedade: &#34;%s&#34;, no campo &#34;%s&#34;.', [pPropriedade, pCampo]));&#13;&#10;end;&#13;&#10;&#13;&#10;function GetPropriedadeIndex(pIndex: Integer; pNome: String): String;&#13;&#10;var&#13;&#10;  I: Integer = 0;&#13;&#10;begin&#13;&#10;  Result := EmptyStr;&#13;&#10;&#13;&#10;  for I := 0 to Pred(TCampoPropriedades) do&#13;&#10;  begin&#13;&#10;    if Lowercase(TCampoPropriedades[I]) = Lowercase(pNome) then&#13;&#10;    begin&#13;&#10;      Result := FConfigGrafico[pIndex][I];&#13;&#10;      Break;&#13;&#10;    end;&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;function GetSituacaoEntrega(pSigla: Char): String;&#13;&#10;begin&#13;&#10;  case Trim(Uppercase(pSigla)) of&#13;&#10;    'EL': Result := 'Na Loja';&#13;&#10;    'AE': Result := 'A Entregar';&#13;&#10;    'AR': Result := 'A Retirar';&#13;&#10;    'EC': Result := 'No Cliente';&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;function GetConfigTermico(pCampo: String): Variant;&#13;&#10;var&#13;&#10;  I: Integer = 0;&#13;&#10;begin&#13;&#10;  Result := EmptyStr;&#13;&#10;&#13;&#10;  for I := 0 to Pred(TConfigTermico) do&#13;&#10;  begin&#13;&#10;    if Lowercase(TConfigTermico[I]) = Lowercase(pCampo) then&#13;&#10;    begin&#13;&#10;      Result := FConfigTermico[I];&#13;&#10;      Break;&#13;&#10;    end;&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure AtualizarCamposGrafico;&#13;&#10;var&#13;&#10;  lCampos: String = EmptyStr;&#13;&#10;  I, lCodigo, lTamnho, lCompUsado, lDisponivel, lCompIndexComp: Integer = 0;&#13;&#10;begin&#13;&#10;  lCompIndexComp := 27;&#13;&#10;  clbGraficoExibir.Items.Clear;&#13;&#10;  clbGraficoDisponivel.Items.Clear;&#13;&#10;&#13;&#10;  for I := 0 to Pred(TCampos) do&#13;&#10;  begin&#13;&#10;    if VerificarCampoInLista(FConfigGrafico, I) then&#13;&#10;    begin&#13;&#10;      case TCampos[I] of&#13;&#10;        'Descrição Produto': begin end;&#13;&#10;        'Imagem do Produto': lCompUsado := lCompUsado + TTamanhoImg[GetPropriedade(TCampos[I], 'Width')];&#13;&#10;        else lCompUsado := lCompUsado + GetPropriedade(TCampos[I], 'Width');&#13;&#10;      end;&#13;&#10;    end else&#13;&#10;    begin&#13;&#10;      clbGraficoDisponivel.Items.Add(TCampos[I]);&#13;&#10;      TfrxMemoControl(Report.FindObject(Format('PreviwMT_%d', [I]))).Free;&#13;&#10;    end;&#13;&#10;  end;&#13;&#10;&#13;&#10;  lDisponivel := 756 - lCompUsado;&#13;&#10;  lblTamanhoDisponivel.Font.Color := IIF(lDisponivel &#60; 0, clRed, clNone);&#13;&#10;  lblTamanhoDisponivel.Caption := Format('Tamanho da Descrição do Produto: %d', [lDisponivel]);&#13;&#10;  GetPropriedade('Descrição Produto', 'Width', IntToStr(IIF(lDisponivel &#60; 0, 0, lDisponivel)));&#13;&#10;&#13;&#10;  for I := 0 to Pred(FConfigGrafico) do&#13;&#10;  begin&#13;&#10;    lCodigo := StrToInt(GetPropriedadeIndex(I, 'Codigo'));&#13;&#10;    lCampos := lCampos + #44 + FormatFloat('00', lCodigo);&#13;&#10;    clbGraficoExibir.Items.Add(TCampos[lCodigo]);&#13;&#10;&#13;&#10;    lTamnho := StrToInt(GetPropriedadeIndex(I, 'Width'));&#13;&#10;    if TCampos[lCodigo] = 'Imagem do Produto' then&#13;&#10;      lTamnho := TTamanhoImg[lTamnho];&#13;&#10;&#13;&#10;    CriarPreviwMemoTitulo(I, lTamnho, lCompIndexComp, TCampos);&#13;&#10;    lCompIndexComp := lCompIndexComp + lTamnho;&#13;&#10;  end;&#13;&#10;&#13;&#10;  FConfig[GetConfigID('LISTA_CAMPOS')] := Copy(lCampos, 2, Length(lCampos));&#13;&#10;  clbGraficoExibir.ItemIndex := FIndexSelecionado;&#13;&#10;end;&#13;&#10;&#13;&#10;function ValidarAlteracaoGrafico: Boolean;&#13;&#10;var&#13;&#10;  I: Integer = 0;&#13;&#10;begin&#13;&#10;  Result := False;&#13;&#10;&#13;&#10;  for I := 0 to Pred(FConfigGrafico) do&#13;&#10;  begin&#13;&#10;    if not (FConfigGrafico[I].CommaText = FGConfigGrafico[I].CommaText) then&#13;&#10;    begin&#13;&#10;      Result := True;&#13;&#10;      Break;&#13;&#10;    end;&#13;&#10;  end;&#13;&#10;&#13;&#10;  BitBtnCancelar.Enabled := Result;&#13;&#10;  BitBtnGravar.Enabled := Result;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure CriarPreviwMemoTitulo(pIndex: Integer; pTamanho: Extended; pIndexComp: Extended; pNome: Array of String);&#13;&#10;var&#13;&#10;  lMemo: TfrxEditControl;&#13;&#10;  lCodigo, lFontSize: Integer = 0;&#13;&#10;begin&#13;&#10;  lCodigo := StrToInt(GetPropriedadeIndex(pIndex, 'Codigo'));&#13;&#10;  lFontSize := StrToInt(GetPropriedadeIndex(pIndex, 'FontSize'));&#13;&#10;  lMemo := TfrxEditControl(Report.FindObject(Format('PreviwMT_%d', [lCodigo])));&#13;&#10;&#13;&#10;  if lMemo = nil then&#13;&#10;    lMemo := TfrxEditControl.Create(DlgConfig);&#13;&#10;&#13;&#10;  lMemo.Font.Style := IIF(GetPropriedadeIndex(pIndex, 'FontBold') = 'S', fsBold, nil);&#13;&#10;  GetPropriedade(TCampos[lCodigo], 'Left', VarToStr(pIndexComp - 27));&#13;&#10;  lMemo.Text := GetPropriedadeIndex(pIndex, 'Text');&#13;&#10;  lMemo.Name := Format('PreviwMT_%d', [lCodigo]);&#13;&#10;  lMemo.OnExit := 'edtPreviwMemoTituloOnExit';&#13;&#10;  lMemo.Font.Size := Trunc(lFontSize);&#13;&#10;  lMemo.Parent := TabSheetConfgGrafico;&#13;&#10;  lMemo.Left := pIndexComp;&#13;&#10;  lMemo.Width := pTamanho;&#13;&#10;  lMemo.TabStop := False;&#13;&#10;  lmemo.Height := 18;&#13;&#10;  lMemo.Top := 210;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure edtPreviwMemoTituloOnExit(Sender: TfrxComponent);&#13;&#10;var&#13;&#10;  lEdit: TfrxEditControl;&#13;&#10;  lCodigo: Integer = 0;&#13;&#10;begin&#13;&#10;  if not (Sender is TfrxEditControl) then&#13;&#10;    Exit;&#13;&#10;&#13;&#10;  lEdit := TfrxEditControl(Sender);&#13;&#10;  lCodigo := StrToInt(StringReplace(lEdit.Name, 'PreviwMT_', EmptyStr));&#13;&#10;  GetPropriedade(TCampos[lCodigo], 'Text', lEdit.Text);&#13;&#10;end;&#13;&#10;&#13;&#10;function VerificarCampoInLista(pLista: Array of TStringList; pID: Integer): Boolean;&#13;&#10;var&#13;&#10;  I: Integer = 0;&#13;&#10;begin&#13;&#10;  Result := False;&#13;&#10;&#13;&#10;  for I := 0 to Pred(pLista) do&#13;&#10;  begin&#13;&#10;    if StrToInt(pLista[I][0]) = pID then&#13;&#10;    begin&#13;&#10;      Result := True;&#13;&#10;      Break;&#13;&#10;    end;&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure AdicionarCampo(var pLista: Array of TStringList; pCodigo, pText, pWidth, pLeft, pHAlign, pFontSize, pFontBold, pMask, pSomar, pExibirCod, pSomenteORC, pExibirBorda: String);&#13;&#10;var&#13;&#10;  I: Integer = 0;&#13;&#10;begin&#13;&#10;  SetLength(pLista, Length(pLista) +1);&#13;&#10;  pLista[Pred(pLista)] := TStringList.Create;&#13;&#10;&#13;&#10;  for I := 0 to Pred(TCampoPropriedades) do&#13;&#10;  begin&#13;&#10;    case TCampoPropriedades[I] of&#13;&#10;      'Codigo': pLista[Pred(pLista)].Add(pCodigo);&#13;&#10;      'Text': pLista[Pred(pLista)].Add(pText);&#13;&#10;      'Width': pLista[Pred(pLista)].Add(pWidth);&#13;&#10;      'Left': pLista[Pred(pLista)].Add(pLeft);&#13;&#10;      'HAlign': pLista[Pred(pLista)].Add(pHAlign);&#13;&#10;      'FontSize': pLista[Pred(pLista)].Add(pFontSize);&#13;&#10;      'FontBold': pLista[Pred(pLista)].Add(pFontBold);&#13;&#10;      'Mask': pLista[Pred(pLista)].Add(pMask);&#13;&#10;      'Somar': pLista[Pred(pLista)].Add(pSomar);&#13;&#10;      'ExibirCod': pLista[Pred(pLista)].Add(pExibirCod);&#13;&#10;      'SomenteOrcamento': pLista[Pred(pLista)].Add(pSomenteORC);&#13;&#10;      'ExibirBorda': pLista[Pred(pLista)].Add(pExibirBorda);&#13;&#10;    end;&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure sbtnUPOnClick(Sender: TfrxComponent);&#13;&#10;var&#13;&#10;  lIndex: Integer = 0;&#13;&#10;begin&#13;&#10;  lIndex := clbGraficoExibir.ItemIndex;&#13;&#10;&#13;&#10;  if SpinButtonClick(clbGraficoExibir, FConfigGrafico, 'UP') then&#13;&#10;  begin&#13;&#10;    AtualizarCamposGrafico;&#13;&#10;    clbGraficoExibir.ItemIndex := lIndex -1;&#13;&#10;    FIndexSelecionado := clbGraficoExibir.ItemIndex;&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure sbtnDownOnClick(Sender: TfrxComponent);&#13;&#10;var&#13;&#10;  lIndex: Integer = 0;&#13;&#10;begin&#13;&#10;  lIndex := clbGraficoExibir.ItemIndex;&#13;&#10;&#13;&#10;  if SpinButtonClick(clbGraficoExibir, FConfigGrafico, 'Down') then&#13;&#10;  begin&#13;&#10;    AtualizarCamposGrafico;&#13;&#10;    clbGraficoExibir.ItemIndex := lIndex +1;&#13;&#10;    FIndexSelecionado := clbGraficoExibir.ItemIndex;&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;function SpinButtonClick(pListBox: TfrxCheckListBoxControl; var pLista: Array of TStringList; pMode: Char): Boolean;&#13;&#10;var&#13;&#10;  lIndex, lPosicao: Integer = 0;&#13;&#10;  lTexto1, lTexto2: String = EmptyStr;&#13;&#10;begin&#13;&#10;  Result := False;&#13;&#10;  lIndex := pListBox.ItemIndex;&#13;&#10;&#13;&#10;  if lIndex = -1 then&#13;&#10;    Exit;&#13;&#10;&#13;&#10;  if (lIndex = 0) and (pMode = 'UP') then&#13;&#10;    Exit;&#13;&#10;&#13;&#10;  if (lIndex = pListBox.Items.Count - 1) and (pMode = 'Down') then&#13;&#10;    Exit;&#13;&#10;&#13;&#10;  case pMode of&#13;&#10;    'UP': lPosicao := -1;&#13;&#10;    'Down': lPosicao := 1;&#13;&#10;  end;&#13;&#10;&#13;&#10;  pListBox.Items.Move(lIndex, lIndex + lPosicao);&#13;&#10;  pListBox.ItemIndex := lIndex + lPosicao;&#13;&#10;&#13;&#10;  lTexto1 := pLista[lIndex].CommaText;&#13;&#10;  lTexto2 := pLista[lIndex + lPosicao].CommaText;&#13;&#10;&#13;&#10;  pLista[lIndex].CommaText := lTexto2;&#13;&#10;  pLista[lIndex + lPosicao].CommaText := lTexto1;&#13;&#10;  Result := True;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure BitBtnPreviewOnClick(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  frxGlobalVariables.Variables['Perfil'] := FPerfil;&#13;&#10;  frxGlobalVariables.Variables['Config'] := FConfig;&#13;&#10;  frxGlobalVariables.Variables['GPerfil'] := FGPerfil;&#13;&#10;  frxGlobalVariables.Variables['GConfig'] := FGConfig;&#13;&#10;  frxGlobalVariables.Variables['PerfilConfig'] := FPerfilConfig;&#13;&#10;  frxGlobalVariables.Variables['ConfigGrafico'] := FConfigGrafico;&#13;&#10;  frxGlobalVariables.Variables['ConfigTermico'] := FConfigTermico;&#13;&#10;  frxGlobalVariables.Variables['GConfigGrafico'] := FGConfigGrafico;&#13;&#10;  frxGlobalVariables.Variables['GConfigTermico'] := FGConfigTermico;&#13;&#10;  frxGlobalVariables.Variables['Preview'] := 'S';&#13;&#10;  DlgConfig.ModalResult := mrOk;&#13;&#10;  Report.ShowReport;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure CheckBoxOnClick(Sender: TfrxComponent);&#13;&#10;var&#13;&#10;  lCheckBox: TfrxCheckBoxControl;&#13;&#10;begin&#13;&#10;  if not (Sender is TfrxCheckBoxControl) then&#13;&#10;    Exit;&#13;&#10;&#13;&#10;  lCheckBox := TfrxCheckBoxControl(Sender);&#13;&#10;&#13;&#10;  case lCheckBox.Checked of&#13;&#10;    True:  FConfig[GetConfigID(lCheckBox.Description)] := 'S';&#13;&#10;    False: FConfig[GetConfigID(lCheckBox.Description)] := 'N';&#13;&#10;  end;&#13;&#10;&#13;&#10;  if lCheckBox.Description = 'MEIA_PAGINA' then&#13;&#10;  begin&#13;&#10;    CheckBox10.Enabled := lCheckBox.Checked;&#13;&#10;    CheckBox10.Checked := IIF(CheckBox10.Enabled, CheckBox10.Checked, False);&#13;&#10;  end;&#13;&#10;&#13;&#10;  ValidarAlteracaoConfig;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure ComboBoxOnChange(Sender: TfrxComponent);&#13;&#10;var&#13;&#10;  lComboBox: TfrxComboBoxControl;&#13;&#10;begin&#13;&#10;  if not (Sender is TfrxComboBoxControl) then&#13;&#10;    Exit;&#13;&#10;&#13;&#10;  lComboBox := TfrxComboBoxControl(Sender);&#13;&#10;  FConfig[GetConfigID(lComboBox.Description)] := lComboBox.ItemIndex;&#13;&#10;&#13;&#10;  if lComboBox.Description in ['DESC_ITEM','DESC_FECH'] then&#13;&#10;    CheckBox29.Enabled := 1 in [GetConfig('DESC_ITEM'), GetConfig('DESC_FECH')];&#13;&#10;&#13;&#10;  ValidarAlteracaoConfig;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure RadioButtonOnClick(Sender: TfrxComponent);&#13;&#10;var&#13;&#10;  lRadioButton: TfrxRadioButtonControl;&#13;&#10;begin&#13;&#10;  if not (Sender is TfrxRadioButtonControl) then&#13;&#10;    Exit;&#13;&#10;&#13;&#10;  lRadioButton := TfrxRadioButtonControl(Sender);&#13;&#10;  FConfig[GetConfigID(lRadioButton.Description)] := lRadioButton.Hint;&#13;&#10;  LabelOrdernacaoP.Caption := Format(TOrderTexto, [StringReplace(lRadioButton.Caption, 'Produto', 'Nenhum')]);&#13;&#10;  CheckBox15.Enabled := GetConfig('AGRUPAMENTO') &#60;&#62; 'N';&#13;&#10;  ValidarAlteracaoConfig;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure sbtnEnderecoUPOnClick(Sender: TfrxComponent);&#13;&#10;var&#13;&#10;  lIndex: Integer = 0;&#13;&#10;begin&#13;&#10;  lIndex := ListBoxEndereco.ItemIndex;&#13;&#10;&#13;&#10;  if lIndex &#60;= 0 then&#13;&#10;    Exit;&#13;&#10;&#13;&#10;  ListBoxEndereco.Items.Move(lIndex, lIndex -1);&#13;&#10;  ListBoxEndereco.ItemIndex := lIndex -1;&#13;&#10;  AtualizarEnderecoConfig;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure sbtnEnderecoDownOnClick(Sender: TfrxComponent);&#13;&#10;var&#13;&#10;  lIndex: Integer = 0;&#13;&#10;begin&#13;&#10;  lIndex := ListBoxEndereco.ItemIndex;&#13;&#10;&#13;&#10;  if lIndex = ListBoxEndereco.Items.Count -1 then&#13;&#10;    Exit;&#13;&#10;&#13;&#10;  ListBoxEndereco.Items.Move(lIndex, lIndex +1);&#13;&#10;  ListBoxEndereco.ItemIndex := lIndex +1;&#13;&#10;  AtualizarEnderecoConfig;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure AtualizarEnderecoConfig;&#13;&#10;var&#13;&#10;  I: Integer = 0;&#13;&#10;begin&#13;&#10;  for I := 0 to ListBoxEndereco.Items.Count -1 do&#13;&#10;    FConfig[GetConfigID(Format('PRI_END_%d', [I]))] := GetEnderecoID(ListBoxEndereco.Items[I]);&#13;&#10;&#13;&#10;  ValidarAlteracaoConfig;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure MemoObsFixaOnExit(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  FConfig[GetConfigID('OBSERVACAO')] := MemoObsFixa.Lines.CommaText;&#13;&#10;  ValidarAlteracaoConfig;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure HeaderNegOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if &#60;QryPrincipal.&#34;OCULTAR_CLI_CONV&#34;&#62; = 'S' then&#13;&#10;    QryNegociacaoPARCELA.Text := '• [QryNegociacao.&#34;PARCELA_2&#34;]'&#13;&#10;  else&#13;&#10;    QryNegociacaoPARCELA.Text := '• [QryNegociacao.&#34;PARCELA&#34;]';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure MasterDataNegOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  MasterDataNeg.Visible := (&#60;QryNegociacao.&#34;NUMERO_PARCELA&#34;&#62; &#62; 0);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure BitBtnGravarOnClick(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  case PageControl.TabIndex of&#13;&#10;    000: GravarConfig;&#13;&#10;    001: GravarConfigGrafico;&#13;&#10;    002: GravarConfigTermico;&#13;&#10;    003: GravarConfigImpresso;&#13;&#10;    else Exit;&#13;&#10;  end;&#13;&#10;&#13;&#10;  ShowMessage('Configurações Gravadas com sucesso!');&#13;&#10;  BitBtnCancelar.Enabled := False;&#13;&#10;  BitBtnGravar.Enabled := False;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure GravarConfig;&#13;&#10;var&#13;&#10;  I: Integer = 0;&#13;&#10;begin&#13;&#10;  for I := 0 to Pred(TConfig, 2) do&#13;&#10;  begin&#13;&#10;    if (FPerfilConfig = 'T') and (TConfig[I] in TNaoTermico) then&#13;&#10;      Continue;&#13;&#10;&#13;&#10;    fnSetCfg(1, Format(TChave, [FPerfilConfig, TConfig[I]]), FConfig[I]);&#13;&#10;  end;&#13;&#10;&#13;&#10;  CopyArray(FConfig, FGConfig);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure GravarConfigGrafico;&#13;&#10;var&#13;&#10;  I, J: Integer = 0;&#13;&#10;  lHasField: Boolean = False;&#13;&#10;begin&#13;&#10;  fnSetCfg(1, Format(TChave, [FPerfilConfig, 'LISTA_CAMPOS']), FConfig[GetConfigID('LISTA_CAMPOS')]);&#13;&#10;&#13;&#10;  for I := 0 to Pred(FConfigGrafico) do&#13;&#10;  begin&#13;&#10;    for J := 0 to Pred(TCampoPropriedades) do&#13;&#10;      fnSetCfg(1, Format(TChaveCampo, ['G', GetPropriedadeIndex(I, 'Codigo'),&#13;&#10;          TCampoPropriedades[J]]), GetPropriedadeIndex(I, TCampoPropriedades[J]));&#13;&#10;  end;&#13;&#10;&#13;&#10;  for I := 0 to Pred(TCampos) do&#13;&#10;  begin&#13;&#10;    lHasField := False;&#13;&#10;&#13;&#10;    for J := 0 to Pred(FConfigGrafico) do&#13;&#10;    begin&#13;&#10;      if StrToInt(FConfigGrafico[J][0]) = I then&#13;&#10;      begin&#13;&#10;        lHasField := True;&#13;&#10;        Break;&#13;&#10;      end;&#13;&#10;    end;&#13;&#10;&#13;&#10;    if not lHasField then&#13;&#10;      fnDropCfg(1, Format(TChaveCampo, ['G', FormatFloat('00', I), EmptyStr]));&#13;&#10;  end;&#13;&#10;&#13;&#10;  CopyArrayStringList(FConfigGrafico, FGConfigGrafico);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure GravarConfigTermico;&#13;&#10;var&#13;&#10;  I: Integer = 0;&#13;&#10;begin&#13;&#10;  for I := 0 to Pred(TConfigTermico) do&#13;&#10;    fnSetCfg(1, Format(TChave, ['T', TConfigTermico[I]]), FConfigTermico[I]);&#13;&#10;&#13;&#10;  CopyArray(FConfigTermico, FGConfigTermico);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure GravarConfigImpresso;&#13;&#10;var&#13;&#10;  I: Integer = 0;&#13;&#10;begin&#13;&#10;  for I := 0 to Pred(TPerfil) do&#13;&#10;    fnSetCfg(1, Format(TChave, ['Impresso', TPerfil[I]]), FPerfil[I]);&#13;&#10;&#13;&#10;  CopyArray(FPerfil, FGPerfil);&#13;&#10;end;&#13;&#10;&#13;&#10;function GetObservacao: String;&#13;&#10;var&#13;&#10;  lLista: TStringList;&#13;&#10;  lObservacao: String = EmptyStr;&#13;&#10;begin&#13;&#10;  Result := EmptyStr;&#13;&#10;  lLista := TStringList.Create;&#13;&#10;&#13;&#10;  try&#13;&#10;    lObservacao := GetConfig('OBSERVACAO');&#13;&#10;    lObservacao := StringReplace(lObservacao, '&#34;,,&#34;', sLineBreak);&#13;&#10;    lObservacao := StringReplace(lObservacao, '&#34;,,', sLineBreak);&#13;&#10;    lObservacao := StringReplace(lObservacao, ',,&#34;', sLineBreak);&#13;&#10;    lObservacao := StringReplace(lObservacao, '&#34;,&#34;', #32);&#13;&#10;    lObservacao := StringReplace(lObservacao, '&#34;,', #32);&#13;&#10;    lObservacao := StringReplace(lObservacao, ',&#34;', #32);&#13;&#10;    lLista.CommaText := lObservacao;&#13;&#10;    Result := Trim(lLista.Text);&#13;&#10;  finally&#13;&#10;    lLista.Free;&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure CopyArrayStringList(var pArray1, pArray2: Array of Variant);&#13;&#10;var&#13;&#10;  I: Integer = 0;&#13;&#10;begin&#13;&#10;  SetLength(pArray2, Length(pArray1));&#13;&#10;  for I := 0 to Pred(pArray1) do&#13;&#10;  begin&#13;&#10;    pArray2[I] := TStringList.Create;&#13;&#10;    TStringList(pArray2[I]).CommaText := TStringList(pArray1[I]).CommaText;&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure CopyArray(var pArray1, pArray2: Array of Variant);&#13;&#10;var&#13;&#10;  I: Integer = 0;&#13;&#10;begin&#13;&#10;  SetLength(pArray2, Length(pArray1));&#13;&#10;  for I := 0 to Pred(pArray1) do&#13;&#10;    pArray2[I] := pArray1[I];&#13;&#10;end;&#13;&#10;&#13;&#10;procedure PageControlOnChange(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  DlgConfigOnResize(Self);&#13;&#10;&#13;&#10;  case PageControl.TabIndex of&#13;&#10;    0: ValidarAlteracaoConfig;&#13;&#10;    1: begin clbGraficoExibirOnClick(Self); ValidarAlteracaoGrafico; end;&#13;&#10;    2: ValidarAlteracaoTermico;&#13;&#10;    3: ValidarAlteracaoPerfil;&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure clbGraficoExibirOnClick(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  FIndexSelecionado := clbGraficoExibir.ItemIndex;&#13;&#10;&#13;&#10;  if FIndexSelecionado &#62;= 0 then&#13;&#10;    FCampoSelecionado := clbGraficoExibir.Items[clbGraficoExibir.ItemIndex]&#13;&#10;  else&#13;&#10;    FCampoSelecionado := EmptyStr;&#13;&#10;&#13;&#10;  cbTamanho.Visible := False;&#13;&#10;  gbConfiguracao.Caption := ' Configuração ';&#13;&#10;  SetEnabledComponent(gbConfiguracao, False);&#13;&#10;&#13;&#10;  if clbGraficoExibir.ItemIndex &#60; 0 then&#13;&#10;    Exit;&#13;&#10;&#13;&#10;  if not (FCampoSelecionado = 'Imagem do Produto') then&#13;&#10;    SetEnabledComponent(gbConfiguracao, True);&#13;&#10;&#13;&#10;  edtWidth.Visible := not cbTamanho.Visible;&#13;&#10;  cbTamanho.Enabled := cbTamanho.Visible;&#13;&#10;&#13;&#10;  gbConfiguracao.Caption := Format(' Configuração: %s ', [FCampoSelecionado]);&#13;&#10;  cbFontSize.ItemIndex := cbFontSize.Items.IndexOf(GetPropriedade(FCampoSelecionado, 'FontSize'));&#13;&#10;  sbtnNegrito.Flat := GetPropriedade(FCampoSelecionado, 'FontBold') = 'N';&#13;&#10;  cbHAlign.ItemIndex := GetPropriedade(FCampoSelecionado, 'HAlign');&#13;&#10;  edtMasck.Text := GetPropriedade(FCampoSelecionado, 'Mask');&#13;&#10;  cbxTotalizar.Checked := GetPropriedade(FCampoSelecionado, 'Somar') = 'S';&#13;&#10;  cbxExibirCodigo.Checked := GetPropriedade(FCampoSelecionado, 'ExibirCod') = 'S';&#13;&#10;  cbxSomenteOrcamento.Checked := GetPropriedade(FCampoSelecionado, 'SomenteOrcamento') = 'S';&#13;&#10;  cbxExibirBorda.Checked := GetPropriedade(FCampoSelecionado, 'ExibirBorda') = 'S';&#13;&#10;&#13;&#10;  if FCampoSelecionado = 'Imagem do Produto' then&#13;&#10;    cbTamanho.ItemIndex := GetPropriedade(FCampoSelecionado, 'Width')&#13;&#10;  else&#13;&#10;    edtWidth.Text := GetPropriedade(FCampoSelecionado, 'Width');&#13;&#10;end;&#13;&#10;&#13;&#10;procedure SetEnabledComponent(pComponent: TfrxComponent; pCondicao: Boolean);&#13;&#10;var&#13;&#10;  I: Integer;&#13;&#10;  lComponente: TList;&#13;&#10;begin&#13;&#10;  cbTamanho.Visible := FCampoSelecionado = 'Imagem do Produto';&#13;&#10;  cbxSomenteOrcamento.Visible := cbTamanho.Visible;&#13;&#10;  cbxExibirBorda.Visible := cbTamanho.Visible;&#13;&#10;  cbxTotalizar.Caption := 'Somente Código';&#13;&#10;  lComponente := pComponent.Objects;&#13;&#10;&#13;&#10;  for I := 0 to (lComponente.Count - 1) do&#13;&#10;    TfrxDialogControl(lComponente.Items[I]).Enabled := pCondicao;&#13;&#10;&#13;&#10;  if not (FCampoSelecionado in ['Marca','Estoque','Ambiente']) then&#13;&#10;  begin&#13;&#10;    cbxTotalizar.Caption := 'Totalizar Itens';&#13;&#10;    cbxExibirCodigo.Enabled := False;&#13;&#10;  end;&#13;&#10;&#13;&#10;  if FCampoSelecionado = 'Descrição Produto' then&#13;&#10;    edtWidth.Enabled := False;&#13;&#10;&#13;&#10;  if not (FCampoSelecionado in ['Quantidade', 'Acréscimo','Desconto','Valor Total']) then&#13;&#10;    cbxTotalizar.Enabled := False;&#13;&#10;&#13;&#10;  if not (FCampoSelecionado in ['Sequência (Produto)','Sequência (Linha)','Código','Código de Barras','Embalagem','Valor Unitário',&#13;&#10;                                'Desconto Unitário','Quantidade','Acréscimo','Desconto','Valor Unitário Líquido','Valor Total']) then&#13;&#10;    edtMasck.Enabled := False;&#13;&#10;&#13;&#10;  cbxSomenteOrcamento.Enabled := cbxSomenteOrcamento.Visible;&#13;&#10;  cbxExibirBorda.Enabled := cbxSomenteOrcamento.Visible;&#13;&#10;&#13;&#10;  if cbxExibirCodigo.Enabled and cbxExibirCodigo.Checked then&#13;&#10;  begin&#13;&#10;    cbxTotalizar.Enabled := True;&#13;&#10;    edtMasck.Enabled := True;&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure cbFontSizeOnChange(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if not (cbFontSize.ItemIndex = cbFontSize.Items.IndexOf(GetPropriedade(FCampoSelecionado, 'FontSize'))) then&#13;&#10;  begin&#13;&#10;    GetPropriedade(FCampoSelecionado, 'FontSize', cbFontSize.Text);&#13;&#10;    AtualizarCamposGrafico;&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure sbtnNegritoOnClick(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  sbtnNegrito.Flat := not sbtnNegrito.Flat;&#13;&#10;  GetPropriedade(FCampoSelecionado, 'FontBold', IIF(sbtnNegrito.Flat, 'N', 'S'));&#13;&#10;  AtualizarCamposGrafico;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure edtWidthOnExit(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if not (edtWidth.Text = GetPropriedade(FCampoSelecionado, 'Width')) then&#13;&#10;  begin&#13;&#10;    GetPropriedade(FCampoSelecionado, 'Width', edtWidth.Text);&#13;&#10;    AtualizarCamposGrafico;&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure cbTamanhoOnChange(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if not (cbTamanho.ItemIndex = GetPropriedade(FCampoSelecionado, 'Width')) then&#13;&#10;  begin&#13;&#10;    GetPropriedade(FCampoSelecionado, 'Width', FormatFloat('00', cbTamanho.ItemIndex));&#13;&#10;    AtualizarCamposGrafico;&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure cbHAlignOnChange(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if not (cbHAlign.ItemIndex = GetPropriedade(FCampoSelecionado, 'HAlign')) then&#13;&#10;    GetPropriedade(FCampoSelecionado, 'HAlign', IntToStr(cbHAlign.ItemIndex));&#13;&#10;end;&#13;&#10;&#13;&#10;procedure edtMasckOnExit(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if not (edtMasck.Text = GetPropriedade(FCampoSelecionado, 'Mask')) then&#13;&#10;    GetPropriedade(FCampoSelecionado, 'Mask', edtMasck.Text);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure cbxSomenteOrcamentoOnClick(Sender: TfrxComponent);&#13;&#10;var&#13;&#10;  lSomenteORC: Char = EmptyStr;&#13;&#10;begin&#13;&#10;  lSomenteORC := IIF(cbxSomenteOrcamento.Checked, 'S', 'N');&#13;&#10;&#13;&#10;  if not (lSomenteORC = GetPropriedade(FCampoSelecionado, 'SomenteOrcamento')) then&#13;&#10;    GetPropriedade(FCampoSelecionado, 'SomenteOrcamento', lSomenteORC);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure cbxExibirBordaOnClick(Sender: TfrxComponent);&#13;&#10;var&#13;&#10;  lExibirBorda: Char = EmptyStr;&#13;&#10;begin&#13;&#10;  lExibirBorda := IIF(cbxExibirBorda.Checked, 'S', 'N');&#13;&#10;&#13;&#10;  if not (lExibirBorda = GetPropriedade(FCampoSelecionado, 'ExibirBorda')) then&#13;&#10;    GetPropriedade(FCampoSelecionado, 'ExibirBorda', lExibirBorda);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure cbxTotalizarOnClick(Sender: TfrxComponent);&#13;&#10;var&#13;&#10;  lSomar: Char = EmptyStr;&#13;&#10;begin&#13;&#10;  lSomar := IIF(cbxTotalizar.Checked, 'S', 'N');&#13;&#10;&#13;&#10;  if not (lSomar = GetPropriedade(FCampoSelecionado, 'Somar')) then&#13;&#10;    GetPropriedade(FCampoSelecionado, 'Somar', lSomar);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure cbxExibirCodigoOnClick(Sender: TfrxComponent);&#13;&#10;var&#13;&#10;  lExibirCod, lApenasCod: Char = EmptyStr;&#13;&#10;begin&#13;&#10;  cbxTotalizar.Enabled := cbxExibirCodigo.Checked;&#13;&#10;  edtMasck.Enabled := cbxExibirCodigo.Checked;&#13;&#10;&#13;&#10;  if not cbxTotalizar.Enabled then&#13;&#10;    cbxTotalizar.Checked := False;&#13;&#10;&#13;&#10;  lExibirCod := IIF(cbxExibirCodigo.Checked, 'S', 'N');&#13;&#10;  lApenasCod := IIF(cbxTotalizar.Checked, 'S', 'N');&#13;&#10;&#13;&#10;  if not (lExibirCod = GetPropriedade(FCampoSelecionado, 'ExibirCod')) then&#13;&#10;  begin&#13;&#10;    GetPropriedade(FCampoSelecionado, 'ExibirCod', lExibirCod);&#13;&#10;    GetPropriedade(FCampoSelecionado, 'Somar', lApenasCod);&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure pgTermicoOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  QryItensSITUACAO_ENTREGA.Frame.Typ := nil;&#13;&#10;  QryItensDESCRICAO_PRODUTO.Frame.Typ := nil;&#13;&#10;  ChildAcrescTermico.Visible := GetConfig('EXIBIR_ACRE_FECH') = 'S';&#13;&#10;  ChildFreteTermico.Visible := GetConfig('EXIBIR_FRETE') = 'S';&#13;&#10;  MemoTermicoDescricao.Lines[0] := 'DESCRIÇÃO';&#13;&#10;  MemoEditObsTermico.Visible := GetConfig('PREENCHER_OBS') = 'S';&#13;&#10;  QryItensDESCRICAO_PRODUTO.Text := '[QryItens.&#34;CODIGO_PRODUTO&#34;] - [QryItens.&#34;DESCRICAO_PRODUTO&#34;]';&#13;&#10;  QryNegociacaoVALOR_TOTAL1.Visible := not (&#60;QryPrincipal.&#34;OCULTAR_CLI_CONV&#34;&#62; = 'S');&#13;&#10;  QryItensDESCRICAO_PRODUTO.Width := QryItensOBSERVACAO1.Width;&#13;&#10;&#13;&#10;  if GetConfigTermico('Marca') = 'S' then&#13;&#10;  begin&#13;&#10;    MemoTermicoDescricao.Lines[0] := MemoTermicoDescricao.Lines[0] + AdicionarCampoDescricao('D', GetConfigTermico('Tipo Marca'), 'Marca');&#13;&#10;    QryItensDESCRICAO_PRODUTO.Lines[0] := Trim(QryItensDESCRICAO_PRODUTO.Lines[0]) + AdicionarCampoDescricao('M', GetConfigTermico('Tipo Marca'));&#13;&#10;  end;&#13;&#10;&#13;&#10;  if GetConfigTermico('Localização') = 'S' then&#13;&#10;  begin&#13;&#10;    MemoTermicoDescricao.Lines[0] := MemoTermicoDescricao.Lines[0] + AdicionarCampoDescricao('D', GetConfigTermico('Tipo Localização'), 'Localização');&#13;&#10;    QryItensDESCRICAO_PRODUTO.Lines[0] := Trim(QryItensDESCRICAO_PRODUTO.Lines[0]) + AdicionarCampoDescricao('L', GetConfigTermico('Tipo Localização'));&#13;&#10;  end;&#13;&#10;&#13;&#10;  case GetConfig('EXIBIR') of&#13;&#10;    1: begin&#13;&#10;      MemoTermicoExibir.Text := '&#60;b&#62;CLIENTE CONVÊNIO&#60;/b&#62;: [QryPrincipal.&#34;CODIGO_USUARIO_CONVENIO&#34;] - [QryPrincipal.&#34;CLIENTE_CONVENIO&#34;]';&#13;&#10;      MemoTermicoExibir.Visible := &#60;QryPrincipal.&#34;CODIGO_USUARIO_CONVENIO&#34;&#62; &#62; 0;&#13;&#10;    end;&#13;&#10;    2: begin&#13;&#10;      MemoTermicoExibir.Text := '&#60;b&#62;CLIENTE PARCEIRO&#60;/b&#62;: [QryPrincipal.&#34;CODIGO_CLIENTE_PARCEIRO&#34;] - [QryPrincipal.&#34;CLIENTE_PARCEIRO&#34;]';&#13;&#10;      MemoTermicoExibir.Visible := &#60;QryPrincipal.&#34;CODIGO_CLIENTE_PARCEIRO&#34;&#62; &#62; 0;&#13;&#10;    end;&#13;&#10;    3: begin&#13;&#10;      MemoTermicoExibir.Text := '&#60;b&#62;IDENTIFICAÇÃO&#60;/b&#62;: [QryPrincipal.&#34;IDENTIFICACAO&#34;]';&#13;&#10;      MemoTermicoExibir.Visible := not (&#60;QryPrincipal.&#34;IDENTIFICACAO&#34;&#62; = EmptyStr);&#13;&#10;    end;&#13;&#10;    4: begin&#13;&#10;      MemoTermicoExibir.Text := '&#60;b&#62;PROPRIEDADE&#60;/b&#62;: [QryPrincipal.&#34;CODIGO_PROPRIEDADE&#34;] - [QryPrincipal.&#34;CLIENTE_PROPRIEDADE&#34;]';&#13;&#10;      MemoTermicoExibir.Visible := &#60;QryPrincipal.&#34;CODIGO_PROPRIEDADE&#34;&#62; &#62; 0;&#13;&#10;    end;&#13;&#10;    else MemoTermicoExibir.Visible := False;&#13;&#10;  end;&#13;&#10;&#13;&#10;  if GetConfig('PREENCHER_OBS') = 'S' then&#13;&#10;    MasterDataTermico.Child := ChildTermicoObs&#13;&#10;  else&#13;&#10;    MasterDataTermico.Child := nil;&#13;&#10;&#13;&#10;  if MemoTermicoExibir.Visible then&#13;&#10;    ChildCliente.Child := ChildTermicoExibir&#13;&#10;  else&#13;&#10;    ChildCliente.Child := nil;&#13;&#10;&#13;&#10;  QryItensVLR_UNT_LIQ.Visible := GetConfigTermico('Valor Unitário Líquido') = 'S';&#13;&#10;  QryItensSITUACAO_ENTREGA.Visible := GetConfigTermico('Sit. de Entrega') = 'S';&#13;&#10;  QryItensQUANTIDADE.Visible := GetConfigTermico('Quantidade') = 'S';&#13;&#10;  QryItensPRECO_UNITARIO.Visible := GetConfigTermico('Valor Unitário') = 'S';&#13;&#10;  QryItensDESCONTO_VALOR.Visible := GetConfigTermico('Desconto') = 'S';&#13;&#10;  QryItensACRESCIMO_VALOR.Visible := GetConfigTermico('Acréscimo') = 'S';&#13;&#10;  QryItensVALOR_TOTAL.Visible := GetConfigTermico('Valor Total') = 'S';&#13;&#10;&#13;&#10;  MemoTermicoVlrUntLiq.Visible := QryItensVLR_UNT_LIQ.Visible;&#13;&#10;  MemoTermicoSitEntrega.Visible := QryItensSITUACAO_ENTREGA.Visible;&#13;&#10;  MemoTermicoQtde.Visible := QryItensQUANTIDADE.Visible;&#13;&#10;  MemoTermicoQtde2.Visible := QryItensQUANTIDADE.Visible;&#13;&#10;  MemoTermicoQtde3.Visible := QryItensQUANTIDADE.Visible;&#13;&#10;  MemoTermicoUnitario.Visible := QryItensPRECO_UNITARIO.Visible;&#13;&#10;  MemoTermicoDesconto.Visible := QryItensDESCONTO_VALOR.Visible;&#13;&#10;  MemoTermicoAcrescimo.Visible := QryItensACRESCIMO_VALOR.Visible;&#13;&#10;  MemoTermicoTotal.Visible := QryItensVALOR_TOTAL.Visible;&#13;&#10;&#13;&#10;  if QryItensSITUACAO_ENTREGA.Visible then&#13;&#10;    QryItensDESCRICAO_PRODUTO.Width := QryItensDESCRICAO_PRODUTO.Width - QryItensSITUACAO_ENTREGA.Width;&#13;&#10;&#13;&#10;  if (GetConfig('AGRUPAR_PROD') = 'S') and (GetConfig('AGRUPAR_KIT') = 'S') then&#13;&#10;    QryAddSQL(QryItens, mmQryItensProdutoKIT.Text)&#13;&#10;  else if GetConfig('AGRUPAR_PROD') = 'S' then&#13;&#10;    QryAddSQL(QryItens, mmQryItensProduto.Text)&#13;&#10;  else if GetConfig('AGRUPAR_KIT') = 'S' then&#13;&#10;    QryAddSQL(QryItens, mmQryItensKIT.Text)&#13;&#10;  else&#13;&#10;    QryAddSQL(QryItens, mmQryItens.Text);&#13;&#10;&#13;&#10;  QryItens.SQL.Add(Format('order by %s', [TOrdenarPor[GetConfig('ORDENAR_POR')]]));&#13;&#10;  ReplaceTermicoAddFields(GetConfigTermico('Localização') = 'S', QryItensSITUACAO_ENTREGA.Visible);&#13;&#10;  AbrirQry(QryItens);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure ReplaceTermicoAddFields(const pLocalizacao, pSituacaoEntrega: Boolean);&#13;&#10;begin&#13;&#10;  if pLocalizacao then&#13;&#10;  begin&#13;&#10;    QryItens.SQL.Text := StringReplace(QryItens.SQL.Text, 'cast(null as type of column orcamento_item.codigo_estoque)', 'oi.codigo_estoque');&#13;&#10;    QryItens.SQL.Text := StringReplace(QryItens.SQL.Text, 'cast(null as type of column estoque_produto.localizacao)', 'ep.localizacao');&#13;&#10;  end;&#13;&#10;&#13;&#10;  if pSituacaoEntrega then&#13;&#10;    QryItens.SQL.Text := StringReplace(QryItens.SQL.Text, 'cast(null as type of column orcamento_item.situacao_entrega)', 'oi.situacao_entrega');&#13;&#10;end;&#13;&#10;&#13;&#10;function AdicionarCampoDescricao(pTipo: Char; pIndex: Integer; pDescricao: String = ''): String;&#13;&#10;var&#13;&#10;  lField: String = EmptyStr;&#13;&#10;  lValidacao: String = '[IIF(IsEmpty(%s), EmptyStr, ''%s'' + %s + ''%s'')]';&#13;&#10;begin&#13;&#10;  Result := EmptyStr;&#13;&#10;&#13;&#10;  case pTipo of&#13;&#10;    'M': lField := '&#60;QryItens.&#34;DESCRICAO_MARCA&#34;&#62;';&#13;&#10;    'L': lField := '&#60;QryItens.&#34;LOCALIZACAO&#34;&#62;';&#13;&#10;    'D': lField := pDescricao;&#13;&#10;  end;&#13;&#10;&#13;&#10;  if pTipo = 'D' then&#13;&#10;    lValidacao := '%s%s%s%s';&#13;&#10;&#13;&#10;  case pIndex of&#13;&#10;    0: Result := Format(lValidacao, [lField,' - ', lField, EmptyStr]);&#13;&#10;    1: Result := Format(lValidacao, [lField,' (', lField, ')']);&#13;&#10;    2: Result := Format(lValidacao, [lField,' [', lField, ']']);&#13;&#10;    3: Result := Format(lValidacao, [lField,' {', lField, '}']);&#13;&#10;    4: Result := Format(lValidacao, [lField,' |', lField, '|']);&#13;&#10;    5: Result := Format(lValidacao, [lField,' &#60;', lField, '&#62;']);&#13;&#10;    else Exit;&#13;&#10;  end;&#13;&#10;&#13;&#10;  if pTipo = 'D' then&#13;&#10;   Result := Uppercase(Copy(Result, Pos(' ', Result), Length(Result)));&#13;&#10;end;&#13;&#10;&#13;&#10;procedure MasterDataTermicoOnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  QryItensSITUACAO_ENTREGA.Frame.Typ := ftTop;&#13;&#10;  QryItensDESCRICAO_PRODUTO.Frame.Typ := ftTop;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure HeaderNegTermicoOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if &#60;QryPrincipal.&#34;OCULTAR_CLI_CONV&#34;&#62; = 'S' then&#13;&#10;    QryNegociacaoPARCELA1.Text := '• [QryNegociacao.&#34;PARCELA_2&#34;]'&#13;&#10;  else&#13;&#10;    QryNegociacaoPARCELA1.Text := '• [QryNegociacao.&#34;PARCELA&#34;]';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure MasterDataNegTermicoOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  MasterDataNegTermico.Visible := &#60;QryNegociacao.&#34;NUMERO_PARCELA&#34;&#62; &#62; 0;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure FooterNegTermicoOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  FooterNegTermico.Visible := &#60;QryPrincipal.&#34;ORCAMENTO_LIQUIDO&#34;&#62; - SUM(&#60;QryNegociacao.&#34;VALOR_TOTAL&#34;&#62;,MasterDataNegTermico,1) &#60; 0;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure FooterNegOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  FooterNeg.Visible := &#60;QryPrincipal.&#34;ORCAMENTO_LIQUIDO&#34;&#62; - SUM(&#60;QryNegociacao.&#34;VALOR_TOTAL&#34;&#62;,MasterDataNeg,1) &#60; 0;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure CheckBoxTermicoOnClick(Sender: TfrxComponent);&#13;&#10;var&#13;&#10;  lCheckBox: TfrxCheckBoxControl;&#13;&#10;begin&#13;&#10;  if not (Sender is TfrxCheckBoxControl) then&#13;&#10;    Exit;&#13;&#10;&#13;&#10;  lCheckBox := TfrxCheckBoxControl(Sender);&#13;&#10;&#13;&#10;  case lCheckBox.Checked of&#13;&#10;    True:  FConfigTermico[GetTermicoID(lCheckBox.Description)] := 'S';&#13;&#10;    False: FConfigTermico[GetTermicoID(lCheckBox.Description)] := 'N';&#13;&#10;  end;&#13;&#10;&#13;&#10;  ValidarAlteracaoTermico;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure ComboBoxTermicoOnChange(Sender: TfrxComponent);&#13;&#10;var&#13;&#10;  lComboBox: TfrxComboBoxControl;&#13;&#10;begin&#13;&#10;  if not (Sender is TfrxComboBoxControl) then&#13;&#10;    Exit;&#13;&#10;&#13;&#10;  lComboBox := TfrxComboBoxControl(Sender);&#13;&#10;  FConfigTermico[GetTermicoID(lComboBox.Description)] := lComboBox.ItemIndex;&#13;&#10;  ValidarAlteracaoTermico;&#13;&#10;end;&#13;&#10;&#13;&#10;function ValidarAlteracaoPerfil: Boolean;&#13;&#10;begin&#13;&#10;  Result := CompararArray(FPerfil, FGPerfil);&#13;&#10;end;&#13;&#10;&#13;&#10;function ValidarAlteracaoConfig: Boolean;&#13;&#10;begin&#13;&#10;  Result := CompararArray(FConfig, FGConfig, 2);&#13;&#10;end;&#13;&#10;&#13;&#10;function ValidarAlteracaoTermico: Boolean;&#13;&#10;begin&#13;&#10;  Result := CompararArray(FConfigTermico, FGConfigTermico);&#13;&#10;end;&#13;&#10;&#13;&#10;function CompararArray(pArray1, pArray2: Array of Variant; pPred: Integer = 1): Boolean;&#13;&#10;var&#13;&#10;  I: Integer = 0;&#13;&#10;begin&#13;&#10;  Result := False;&#13;&#10;&#13;&#10;  for I := 0 to Pred(pArray1, pPred) do&#13;&#10;  begin&#13;&#10;    if not (pArray1[I] = pArray2[I]) then&#13;&#10;    begin&#13;&#10;      Result := True;&#13;&#10;      Break;&#13;&#10;    end;&#13;&#10;  end;&#13;&#10;&#13;&#10;  BitBtnCancelar.Enabled := Result;&#13;&#10;  BitBtnGravar.Enabled := Result;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure AtualizarDialogoTermico(pComponent: Array of TfrxGroupBoxControl);&#13;&#10;var&#13;&#10;  I,J: Integer = 0;&#13;&#10;  lComponente: TList;&#13;&#10;  lEnabled: Boolean = False;&#13;&#10;  lDescription: String = EmptyStr;&#13;&#10;begin&#13;&#10;  for I := 0 to Pred(pComponent) do&#13;&#10;  begin&#13;&#10;    lComponente := pComponent[I].Objects;&#13;&#10;&#13;&#10;    for J := 0 to (lComponente.Count - 1) do&#13;&#10;    begin&#13;&#10;      lEnabled := True;&#13;&#10;      lDescription := TfrxDialogComponent(lComponente.Items[J]).Description;&#13;&#10;&#13;&#10;      if IsEmpty(lDescription) then&#13;&#10;        Continue;&#13;&#10;&#13;&#10;      case lComponente.Items[J].ClassName of&#13;&#10;        'TfrxComboBoxControl': TfrxComboBoxControl(lComponente.Items[J]).ItemIndex := GetConfigTermico(lDescription);&#13;&#10;        'TfrxCheckBoxControl': TfrxCheckBoxControl(lComponente.Items[J]).Checked := GetConfigTermico(lDescription) = 'S';&#13;&#10;      end;&#13;&#10;&#13;&#10;      case lComponente.Items[J].ClassName of&#13;&#10;        'TfrxComboBoxControl': TfrxComboBoxControl(lComponente.Items[J]).Enabled := lEnabled;&#13;&#10;        'TfrxCheckBoxControl': TfrxCheckBoxControl(lComponente.Items[J]).Enabled := lEnabled;&#13;&#10;      end;&#13;&#10;    end;&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure ReportSummaryTermicoOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  ReportSummaryTermico.Visible := not (&#60;frxDBDCadastral.&#34;OBSERVACAO&#34;&#62; = EmptyStr);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure sbtnQtdeViasImpUPOnClick(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  AtualizarQtdeViasImp('UP');&#13;&#10;end;&#13;&#10;&#13;&#10;procedure sbtnQtdeViasImpDownOnClick(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  AtualizarQtdeViasImp('Down');&#13;&#10;end;&#13;&#10;&#13;&#10;procedure AtualizarQtdeViasImp(pTipo: Char);&#13;&#10;var&#13;&#10;  lQtde: Integer = 0;&#13;&#10;begin&#13;&#10;  lQtde := StrToInt(EditQtdeViasImp.Text);&#13;&#10;&#13;&#10;  case Uppercase(pTipo) of&#13;&#10;      'UP': Inc(lQtde);&#13;&#10;    'DOWN': Dec(lQtde);&#13;&#10;    else Exit;&#13;&#10;  end;&#13;&#10;&#13;&#10;  if (lQtde &#60; 1) or (lQtde &#62; 99) then&#13;&#10;    Exit;&#13;&#10;&#13;&#10;  EditQtdeViasImp.Text := IntToStr(lQtde);&#13;&#10;  FConfig[GetConfigID('QTDE_VIAS_IMP')] := lQtde;&#13;&#10;  ValidarAlteracaoConfig;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure MemoObsFixaOnKeyPress(Sender: TfrxComponent; var Key: Char);&#13;&#10;begin&#13;&#10;  if (GetTamanhoObsFixa = 0) and not (Key = #8) then&#13;&#10;    Key := #0;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure MemoObsFixaOnKeyUp(Sender: TfrxComponent; var Key: Word; Shift: Integer);&#13;&#10;begin&#13;&#10;  lblCaractere.Caption := Format('Caracteres restantes: %d', [GetTamanhoObsFixa]);&#13;&#10;end;&#13;&#10;&#13;&#10;function GetTamanhoObsFixa: Integer;&#13;&#10;const&#13;&#10;  CTags = ['&#60;b&#62;','&#60;/b&#62;','&#60;i&#62;','&#60;/i&#62;','&#60;sup&#62;','&#60;/sup&#62;','&#60;sub&#62;','&#60;/sub&#62; ','&#60;/font&#62;'];&#13;&#10;var&#13;&#10;  I: Integer;&#13;&#10;  lTexto, lTag: String = EmptyStr;&#13;&#10;begin&#13;&#10;  lTexto := MemoObsFixa.Lines.Text;&#13;&#10;&#13;&#10;  for I := 0 to Pred(CTags) do&#13;&#10;    lTexto := StringReplace(lTexto, CTags[I], EmptyStr);&#13;&#10;&#13;&#10;  while Pos('&#60;font color', lTexto) &#62; 0 do&#13;&#10;  begin&#13;&#10;    lTag := Copy(lTexto, Pos('&#60;font color', lTexto), Pos('&#62;', lTexto) - Pos('&#60;font color', lTexto) +1);&#13;&#10;    lTexto := StringReplace(lTexto, lTag, EmptyStr);&#13;&#10;  end;&#13;&#10;&#13;&#10;  lTexto := StringReplace(lTexto, sLineBreak, EmptyStr);&#13;&#10;  Result := 150 - Length(lTexto);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure MasterDataGraficoOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  Inc(FSequencia);&#13;&#10;  if Report.FindObject('ImagemProduto') then&#13;&#10;  begin&#13;&#10;    try&#13;&#10;      TfrxPictureView(Report.FindObject('ImagemProduto')).LoadFromFile(&#60;QryItens.&#34;FIGURA&#34;&#62;);&#13;&#10;    except&#13;&#10;      TfrxPictureView(Report.FindObject('ImagemProduto')).Picture := nil;&#13;&#10;    end;&#13;&#10;  end;&#13;&#10;&#13;&#10;  SetLength(FListaProdutos, &#60;Line#&#62;);&#13;&#10;  FListaProdutos[&#60;Line#&#62; -1] := TStringList.Create;&#13;&#10;  FListaProdutos[&#60;Line#&#62; -1].Add(&#60;QryItens.&#34;CODIGO_ITEM&#34;&#62;);&#13;&#10;  FListaProdutos[&#60;Line#&#62; -1].Add(FormatFloat('000', &#60;QryItens.&#34;SEQUENCIA&#34;&#62;) + '  ' + FormatFloat('000000', &#60;QryItens.&#34;CODIGO_PRODUTO&#34;&#62;) + ' - ' + &#60;QryItens.&#34;DESCRICAO_PRODUTO&#34;&#62;);&#13;&#10;  FListaProdutos[&#60;Line#&#62; -1].Add(&#60;QryItens.&#34;OBSERVACAO&#34;&#62;);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure MasterDataTermicoOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  SetLength(FListaProdutos, &#60;Line#&#62;);&#13;&#10;  FListaProdutos[&#60;Line#&#62; -1] := TStringList.Create;&#13;&#10;  FListaProdutos[&#60;Line#&#62; -1].Add(&#60;QryItens.&#34;CODIGO_ITEM&#34;&#62;);&#13;&#10;  FListaProdutos[&#60;Line#&#62; -1].Add(FormatFloat('000', &#60;QryItens.&#34;SEQUENCIA&#34;&#62;) + '  ' + FormatFloat('000000', &#60;QryItens.&#34;CODIGO_PRODUTO&#34;&#62;) + ' - ' + &#60;QryItens.&#34;DESCRICAO_PRODUTO&#34;&#62;);&#13;&#10;  FListaProdutos[&#60;Line#&#62; -1].Add(&#60;QryItens.&#34;OBSERVACAO&#34;&#62;);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure MemoEditObsOnPreviewClick(Sender: TfrxView; Button: TMouseButton; Shift: Integer; var Modified: Boolean);&#13;&#10;var&#13;&#10;  lCaption: String = EmptyStr;&#13;&#10;begin&#13;&#10;  case &#60;frxDBDCadastral.&#34;TIPO_ORCAMENTO&#34;&#62; of&#13;&#10;    'A': lCaption := 'Orçamento: %d  •  Observação de Produtos';&#13;&#10;    'P': lCaption := 'DAV-Pedido: %d  •  Observação de Produtos';&#13;&#10;    'O': lCaption := 'DAV-Orçamento: %d  •  Observação de Produtos';&#13;&#10;    'C': lCaption := 'DAV-Condicional: %d  •  Observação de Produtos';&#13;&#10;  end;&#13;&#10;&#13;&#10;  DlgObservacao.Caption := Format(lCaption, [&#60;frxDBDCadastral.&#34;CODIGO&#34;&#62;]);&#13;&#10;  DlgObservacao.ShowModal;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure MemoEditObsOnMouseEnter(Sender: TfrxView; var Modified: Boolean);&#13;&#10;begin&#13;&#10;  TfrxMemoView(Sender).Cursor := crHandPoint;&#13;&#10;  TfrxMemoView(Sender).Font.Color := clWhite;&#13;&#10;  TfrxMemoView(Sender).Color := $004766E7;&#13;&#10;  Modified := True;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure MemoEditObsOnMouseLeave(Sender: TfrxView; var Modified: Boolean);&#13;&#10;begin&#13;&#10;  TfrxMemoView(Sender).Cursor := crDefault;&#13;&#10;  TfrxMemoView(Sender).Font.Color := clDefault;&#13;&#10;  TfrxMemoView(Sender).Color := $00CCD7FF;&#13;&#10;  Modified := True;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure DlgObservacaoOnResize(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  DlgObservacao.ClientHeight := 385;&#13;&#10;  DlgObservacao.ClientWidth  := 605;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure DlgObservacaoOnShow(Sender: TfrxComponent);&#13;&#10;var&#13;&#10;  I: Integer = 0;&#13;&#10;begin&#13;&#10;  ListBoxProdutos.Items.Clear;&#13;&#10;&#13;&#10;  for I := 0 to Pred(FListaProdutos) do&#13;&#10;    ListBoxProdutos.Items.Add(FListaProdutos[I][1]);&#13;&#10;&#13;&#10;  ListBoxProdutos.ItemIndex := 0;&#13;&#10;  ListBoxProdutosOnClick(Self);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure ListBoxProdutosOnClick(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  MemoObservacaoItem.Lines.Text := FListaProdutos[ListBoxProdutos.ItemIndex][2];&#13;&#10;end;&#13;&#10;&#13;&#10;procedure MemoObservacaoItemOnKeyUp(Sender: TfrxComponent; var Key: Word; Shift: Integer);&#13;&#10;begin&#13;&#10;  lblObsLimite.Caption := 'Limite: ' + IntToStr(150 - Length(MemoObservacaoItem.Lines.Text));&#13;&#10;  BitBtnGravarOK.Caption := '&#38;Gravar';&#13;&#10;end;&#13;&#10;&#13;&#10;procedure MemoObservacaoItemOnExit(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if ListBoxProdutos.ItemIndex &#60; 0 then&#13;&#10;    Exit;&#13;&#10;&#13;&#10;  if MemoObservacaoItem.Lines.Text = FListaProdutos[ListBoxProdutos.ItemIndex][2] then&#13;&#10;    Exit;&#13;&#10;&#13;&#10;  FListaProdutos[ListBoxProdutos.ItemIndex][2] := MemoObservacaoItem.Lines.Text;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure BitBtnGravarOKOnClick(Sender: TfrxComponent);&#13;&#10;const&#13;&#10;  CScript = 'update ORCAMENTO_ITEM set OBSERVACAO = %s where CODIGO = %s';&#13;&#10;var&#13;&#10;  I: Integer = 0;&#13;&#10;  lTexto, lScript, lRetorno: String = EmptyStr;&#13;&#10;begin&#13;&#10;  if BitBtnGravarOK.Caption = '&#38;OK' then&#13;&#10;  begin&#13;&#10;    DlgObservacao.ModalResult := mrCancel;&#13;&#10;    Exit;&#13;&#10;  end;&#13;&#10;&#13;&#10;  for I := 0 to Pred(FListaProdutos) do&#13;&#10;  begin&#13;&#10;    lTexto := #39 + StringReplace(FListaProdutos[I][2], sLineBreak, EmptyStr) + #39;&#13;&#10;    if IsEmpty(FListaProdutos[I][2]) then&#13;&#10;      lTexto := 'null';&#13;&#10;&#13;&#10;    lScript := Format(CScript, [lTexto, FListaProdutos[I][0]]);&#13;&#10;    lRetorno := lRetorno + ExecSQLScript(lScript) + sLineBreak + sLineBreak;&#13;&#10;  end;&#13;&#10;&#13;&#10;  if not IsEmpty(lRetorno) then&#13;&#10;    GeraMensagem(lRetorno, True, False)&#13;&#10;  else&#13;&#10;  begin&#13;&#10;    BitBtnGravarOK.Caption := '&#38;OK';&#13;&#10;    GeraMensagem('Observação salva com sucesso!', True, False);&#13;&#10;    DlgObservacao.ModalResult := mrOk;&#13;&#10;    BitBtnPreviewOnClick(Self);&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure ChildGraficoObsOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  ChildGraficoObs.Visible := not IsEmpty(&#60;QryItens.&#34;OBSERVACAO&#34;&#62;);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure ChildTermicoObsOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  ChildTermicoObs.Visible := not IsEmpty(&#60;QryItens.&#34;OBSERVACAO&#34;&#62;);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure BitBtnCancelarOnClick(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if GeraPergunta('Deseja cancelar as alterações feitas?') = 7 then&#13;&#10;    Exit;&#13;&#10;&#13;&#10;  case PageControl.TabIndex of&#13;&#10;    001: begin CopyArrayStringList(FGConfigGrafico, FConfigGrafico); AtualizarCamposGrafico; end;&#13;&#10;    002: begin CopyArray(FGConfigTermico, FConfigTermico); AtualizarDialogoTermico([GroupBox9]); end;&#13;&#10;    003: begin CopyArray(FGPerfil, FPerfil); AtualizarImpresso; end;&#13;&#10;    else begin CopyArray(FGConfig, FConfig); AtualizarDialogo([GroupBox2,GroupBox3,GroupBox4,GroupBox5,tsGraficoPagina,tsGraficoItens,GroupBox7]); end;&#13;&#10;  end;&#13;&#10;&#13;&#10;  BitBtnCancelar.Enabled := False;&#13;&#10;  BitBtnGravar.Enabled := False;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure BitBtnDefaultOnClick(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if GeraPergunta('Deseja restaurar as configurações originais?') = 7 then&#13;&#10;    Exit;&#13;&#10;&#13;&#10;  case PageControl.TabIndex of&#13;&#10;    001: DefaultConfigGrafico;&#13;&#10;    002: begin CopyArray(TDefaulTermico, FConfigTermico); AtualizarDialogoTermico([GroupBox9]); end;&#13;&#10;    003: begin CopyArray(TDefaultPerfil, FPerfil); AtualizarImpresso; end;&#13;&#10;    else begin&#13;&#10;      CopyArray(IIF(ComboBoxTipo.ItemIndex = 0, TDefaultG, TDefaultT), FConfig);&#13;&#10;      AtualizarDialogo([GroupBox2,GroupBox3,GroupBox4,GroupBox5,tsGraficoPagina,tsGraficoItens,GroupBox7]);&#13;&#10;    end;&#13;&#10;  end;&#13;&#10;&#13;&#10;  case PageControl.TabIndex of&#13;&#10;    0: ValidarAlteracaoConfig;&#13;&#10;    1: begin clbGraficoExibirOnClick(Self); ValidarAlteracaoGrafico; end;&#13;&#10;    2: ValidarAlteracaoTermico;&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure DefaultConfigGrafico;&#13;&#10;const&#13;&#10;  lLista = ['18','02','06','22','14','00','04','21'];&#13;&#10;var&#13;&#10;  I: Integer;&#13;&#10;  lCodigo, lText, lWidth, lHAlign, lMask, lSomar: String = EmptyStr;&#13;&#10;begin&#13;&#10;  LimparArray(FConfigGrafico);&#13;&#10;&#13;&#10;  for I := 0 to Pred(lLista) do&#13;&#10;  begin&#13;&#10;    lCodigo := lLista[I];&#13;&#10;    lText := TDefaultText[StrToInt(lCodigo)];&#13;&#10;    lWidth := TDefaultWidth[StrToInt(lCodigo)];&#13;&#10;    lHAlign := TDefaultHAlign[StrToInt(lCodigo)];&#13;&#10;    lMask := TDefaultMask[StrToInt(lCodigo)];&#13;&#10;    lSomar := TDefaultSomar[StrToInt(lCodigo)];&#13;&#10;&#13;&#10;    AdicionarCampo(FConfigGrafico, lCodigo, lText, lWidth, '0', lHAlign, '08', 'N', lMask, lSomar, 'N', 'N', 'N');&#13;&#10;  end;&#13;&#10;&#13;&#10;  FConfig[GetConfigID('LISTA_CAMPOS')] := '18,02,06,22,14,00,04,21';&#13;&#10;  AtualizarCamposGrafico;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure DAVImpressoOnClick(Sender: TfrxComponent);&#13;&#10;var&#13;&#10;  lRadioButton: TfrxRadioButtonControl;&#13;&#10;begin&#13;&#10;  if Sender is TfrxRadioButtonControl then&#13;&#10;  begin&#13;&#10;    lRadioButton := TfrxRadioButtonControl(Sender);&#13;&#10;&#13;&#10;    case lRadioButton.Description of&#13;&#10;      'DAV-C': FPerfil[0] := Copy(lRadioButton.Caption, 1, 1);&#13;&#10;      'DAV-O': FPerfil[1] := Copy(lRadioButton.Caption, 1, 1);&#13;&#10;      'DAV-P': FPerfil[2] := Copy(lRadioButton.Caption, 1, 1);&#13;&#10;    end;&#13;&#10;&#13;&#10;    ValidarAlteracaoPerfil;&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure DlgHTMLInfoOnResize(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  TfrxDialogPage(Sender).ClientHeight := 542;&#13;&#10;  TfrxDialogPage(Sender).ClientWidth := 586;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Image1OnClick(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  DlgHTMLInfo.ShowModal;&#13;&#10;end;&#13;&#10;&#13;&#10;function Pred(pArray: Array of Variant; Qtde: Integer = 1): Integer;&#13;&#10;begin&#13;&#10;  Result := Length(pArray) - Qtde;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure LimparArray(var pArray: Array of Variant);&#13;&#10;var&#13;&#10;  I: Integer = 0;&#13;&#10;begin&#13;&#10;  for I := Pred(pArray) downto 0 do&#13;&#10;  begin&#13;&#10;    if pArray[I] is TStringList then&#13;&#10;      TStringList(pArray[I]).Free;&#13;&#10;    SetLength(pArray, I);&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure GroupBox15OnClick(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;&#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;end." OnStartReport="FrxRelatorioOnStartReport" OnReportPrint="FrxRCadastralOnReportPrint">
